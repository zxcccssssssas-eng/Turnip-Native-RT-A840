+++ b/src/freedreno/vulkan/tu_nir_rt.cc
@@ -0,0 +1,1714 @@
+/*
+ * Copyright © 2024 Valve Corporation
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "tu_device.h"
+#include "tu_nir_rt.h"
+#include "tu_nir_rt_common.h"
+#include "tu_pipeline.h"
+
+#include "bvh/tu_bvh_defines.h"
+
+#include "nir_builder.h"
+
+static bool
+resize_deref(nir_builder *b, nir_deref_instr *deref,
+             unsigned num_components, unsigned bit_size)
+{
+   if (deref->def.num_components == num_components &&
+       deref->def.bit_size == bit_size)
+      return false;
+
+   /* NIR requires array indices have to match the deref bit size */
+   if (deref->def.bit_size != bit_size &&
+       (deref->deref_type == nir_deref_type_array ||
+        deref->deref_type == nir_deref_type_ptr_as_array)) {
+      b->cursor = nir_before_instr(&deref->instr);
+      nir_def *idx;
+      if (nir_src_is_const(deref->arr.index)) {
+         idx = nir_imm_intN_t(b, nir_src_as_int(deref->arr.index), bit_size);
+      } else {
+         idx = nir_i2iN(b, deref->arr.index.ssa, bit_size);
+      }
+      nir_src_rewrite(&deref->arr.index, idx);
+   }
+
+   deref->def.num_components = num_components;
+   deref->def.bit_size = bit_size;
+
+   return true;
+}
+
+/* We reserve the first 12B of the stack for callee data pointers */
+#define TU_STACK_CALL_DATA_PTR_OFFSET 0
+#define TU_STACK_RESUME_INDEX_OFFSET 8
+#define TU_STACK_CALLEE_DATA_SIZE 12
+
+/* We require the stack to be 4b aligned at the start of a shader */
+#define TU_STACK_ALIGN 4
+
+/* We have our own load/store scratch helpers because they emit a global
+ * memory read or write based on the scratch_base_ptr system value rather
+ * than a load/store_scratch intrinsic.
+ */
+static nir_def *
+tu_nir_rt_load_scratch(nir_builder *b, uint32_t offset, unsigned align,
+                       unsigned num_components, unsigned bit_size)
+{
+   nir_def *addr =
+      nir_iadd_imm(b, nir_load_scratch_base_ptr(b, 1, 64, 1), offset);
+   return nir_load_global(b, num_components, bit_size, addr,
+                          .align_mul = MIN2(align, TU_STACK_ALIGN));
+}
+
+static inline void
+tu_nir_rt_store_scratch(nir_builder *b, uint32_t offset, unsigned align,
+                        nir_def *value, nir_component_mask_t write_mask)
+{
+   nir_def *addr =
+      nir_iadd_imm(b, nir_load_scratch_base_ptr(b, 1, 64, 1), offset);
+   nir_store_global(b, value, addr,
+                    .write_mask = (write_mask) &
+                                   BITFIELD_MASK(value->num_components),
+                    .align_mul = MIN2(align, TU_STACK_ALIGN));
+}
+
+static bool
+lower_rt_io_derefs(nir_shader *shader)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+
+   bool progress = false;
+
+   unsigned num_shader_call_vars = 0;
+   nir_foreach_variable_with_modes(var, shader, nir_var_shader_call_data)
+      num_shader_call_vars++;
+
+   unsigned num_ray_hit_attrib_vars = 0;
+   nir_foreach_variable_with_modes(var, shader, nir_var_ray_hit_attrib)
+      num_ray_hit_attrib_vars++;
+
+   /* At most one payload is allowed because it's an input.  Technically, this
+    * is also true for hit attribute variables.  However, after we inline an
+    * any-hit shader into an intersection shader, we can end up with multiple
+    * hit attribute variables.  They'll end up mapping to a cast from the same
+    * base pointer so this is fine.
+    */
+   assert(num_shader_call_vars <= 1);
+
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+
+   nir_def *call_data_addr = NULL;
+   if (num_shader_call_vars > 0) {
+      assert(shader->scratch_size >= TU_STACK_CALLEE_DATA_SIZE);
+      call_data_addr =
+         tu_nir_rt_load_scratch(&b, TU_STACK_CALL_DATA_PTR_OFFSET, 8,
+                                 1, 64);
+      progress = true;
+   }
+
+   mesa_shader_stage stage = shader->info.stage;
+   nir_def *hit_attrib_addr = NULL;
+   if (num_ray_hit_attrib_vars > 0) {
+      assert(stage == MESA_SHADER_ANY_HIT ||
+             stage == MESA_SHADER_CLOSEST_HIT ||
+             stage == MESA_SHADER_INTERSECTION);
+      hit_attrib_addr = nir_load_rt_hit_attributes_addr_ir3(&b);
+      progress = true;
+   }
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_deref)
+            continue;
+
+         nir_deref_instr *deref = nir_instr_as_deref(instr);
+         if (nir_deref_mode_is(deref, nir_var_shader_call_data)) {
+            deref->modes = nir_var_function_temp;
+            if (deref->deref_type == nir_deref_type_var) {
+               b.cursor = nir_before_instr(&deref->instr);
+               nir_deref_instr *cast =
+                  nir_build_deref_cast(&b, call_data_addr,
+                                       nir_var_function_temp,
+                                       deref->var->type, 0);
+               nir_def_replace(&deref->def, &cast->def);
+               progress = true;
+            }
+         } else if (nir_deref_mode_is(deref, nir_var_ray_hit_attrib)) {
+            deref->modes = nir_var_function_temp;
+            if (deref->deref_type == nir_deref_type_var) {
+               b.cursor = nir_before_instr(&deref->instr);
+               nir_deref_instr *cast =
+                  nir_build_deref_cast(&b, hit_attrib_addr,
+                                       nir_var_function_temp,
+                                       deref->type, 0);
+               nir_def_replace(&deref->def, &cast->def);
+               progress = true;
+            }
+         }
+
+         /* We're going to lower all function_temp memory to scratch using
+          * 64-bit addresses.  We need to resize all our derefs first or else
+          * nir_lower_explicit_io will have a fit.
+          */
+         if (nir_deref_mode_is(deref, nir_var_function_temp) &&
+             resize_deref(&b, deref, 1, 64))
+            progress = true;
+      }
+   }
+
+   nir_foreach_variable_with_modes_safe(var, shader, nir_var_shader_call_data)
+      exec_node_remove(&var->node);
+   nir_foreach_variable_with_modes_safe(var, shader, nir_var_ray_hit_attrib)
+      exec_node_remove(&var->node);
+
+   return nir_progress(progress, impl, nir_metadata_control_flow);
+}
+
+
+/** Lowers ray-tracing shader I/O and scratch access
+ *
+ * SPV_KHR_ray_tracing adds three new types of I/O, each of which need their
+ * own bit of special care:
+ *
+ *  - Shader payload data:  This is represented by the IncomingCallableData
+ *    and IncomingRayPayload storage classes which are both represented by
+ *    nir_var_call_data in NIR.  There is at most one of these per-shader and
+ *    they contain payload data passed down the stack from the parent shader
+ *    when it calls executeCallable() or traceRay().  In our implementation,
+ *    the actual storage lives in the calling shader's scratch space and we're
+ *    passed a pointer to it.
+ *
+ *  - Hit attribute data:  This is represented by the HitAttribute storage
+ *    class in SPIR-V and nir_var_ray_hit_attrib in NIR.  For triangle
+ *    geometry, it's supposed to contain two floats which are the barycentric
+ *    coordinates.  For AABS/procedural geometry, it contains the hit data
+ *    written out by the intersection shader.  In our implementation, it's a
+ *    64-bit pointer which points either to the u/v area of the relevant
+ *    rqi data structure or the space right after the HW ray stack entry.
+ *
+ *  - Shader record buffer data:  This allows read-only access to the data
+ *    stored in the SBT right after the bindless shader handles.  It's
+ *    effectively a UBO with a magic address.  Coming out of spirv_to_nir,
+ *    we get a nir_intrinsic_load_shader_record_ptr which is cast to a
+ *    nir_var_mem_global deref and all access happens through that.  The
+ *    shader_record_ptr system value is handled in tu _nir_lower_rt_intrinsics
+ *    and we assume nir_lower_explicit_io is called elsewhere thanks to
+ *    VK_KHR_buffer_device_address so there's really nothing to do here.
+ *
+ * We also handle lowering any remaining function_temp variables to scratch at
+ * this point.  This gets rid of any remaining arrays and also takes care of
+ * the sending side of ray payloads where we pass pointers to a function_temp
+ * variable down the call stack.
+ */
+static void
+lower_rt_io_and_scratch(nir_shader *nir)
+{
+   /* First, we to ensure all the I/O variables have explicit types.  Because
+    * these are shader-internal and don't come in from outside, they don't
+    * have an explicit memory layout and we have to assign them one.
+    */
+   NIR_PASS(_, nir, nir_lower_vars_to_explicit_types,
+              nir_var_function_temp |
+              nir_var_shader_call_data |
+              nir_var_ray_hit_attrib,
+              glsl_get_natural_size_align_bytes);
+
+   /* Now patch any derefs to I/O vars */
+   NIR_PASS(_, nir, lower_rt_io_derefs);
+
+   /* Finally, lower any remaining function_temp, mem_constant, or
+    * ray_hit_attrib access to 64-bit global memory access.
+    */
+   NIR_PASS(_, nir, nir_lower_explicit_io,
+              nir_var_function_temp |
+              nir_var_mem_constant |
+              nir_var_ray_hit_attrib,
+              nir_address_format_64bit_global);
+}
+
+static nir_def *
+tu_nir_return_index(nir_builder *b)
+{
+   return tu_nir_rt_load_scratch(b, TU_STACK_RESUME_INDEX_OFFSET,
+                                 4 /* align */, 1, 32);
+}
+
+/** This is a pseudo-op which does a bindless return
+ *
+ * It loads the return address from the stack and spawns the resume shader.
+ */
+static inline void
+tu_nir_rt_return(struct nir_builder *b)
+{
+   nir_def *resume_addr = tu_nir_return_index(b);
+   nir_rt_spawn_thread_ir3(b, resume_addr);
+}
+
+
+/* These flags must match the SPIR-V RayFlags enum */
+#define TU_RAY_FLAG_TERMINATE_ON_FIRST_HIT 0x04
+#define TU_RAY_FLAG_SKIP_CLOSEST_HIT_SHADER 0x08
+
+static void
+build_terminate_ray(nir_builder *b)
+{
+   nir_def *skip_closest_hit = nir_test_mask(b, nir_load_ray_flags(b),
+      TU_RAY_FLAG_SKIP_CLOSEST_HIT_SHADER);
+   nir_def *return_index = tu_nir_return_index(b);
+   nir_def *else_index;
+   nir_push_if(b, skip_closest_hit);
+   {
+      /* The shader that calls traceRay() is unable to access any ray hit
+       * information except for that which is explicitly written into the ray
+       * payload by shaders invoked during the trace.  If there's no closest-
+       * hit shader, then accepting the hit has no observable effect; it's
+       * just extra memory traffic for no reason.
+       */
+   }
+   nir_push_else(b, NULL);
+   {
+      /* The closest hit shader is in the same shader group as the any-hit
+       * shader that we're currently in.  We can get the address for its SBT
+       * handle by looking at the shader record pointer and subtracting the
+       * size of a SBT handle. Then get the offset of the closest hit index.
+       */
+      nir_def *closest_hit_addr =
+         nir_iadd_imm(b, nir_load_shader_record_ptr(b),
+                        -TU_RT_HANDLE_SIZE +
+                        offsetof(struct tu_pipeline_group_handle, closest_hit_index));
+      nir_def *closest_hit = nir_load_global(b, 1, 32, closest_hit_addr,
+                                             .align_mul = 4);
+
+      skip_closest_hit = nir_ieq_imm(b, closest_hit, TU_SHADER_UNUSED);
+      nir_push_if(b, skip_closest_hit);
+      {
+      }
+      nir_push_else(b, NULL);
+      {
+         nir_rt_commit_hit_ir3(b);
+      }
+      nir_pop_if(b, NULL);
+      else_index = nir_if_phi(b, return_index, closest_hit);
+   }
+   nir_pop_if(b, NULL);
+   nir_def *jump_index = nir_if_phi(b, return_index, else_index);
+   nir_rt_spawn_thread_ir3(b, jump_index);
+   nir_jump(b, nir_jump_halt);
+}
+
+
+/** Lowers away ray walk intrinsics
+ *
+ * This lowers terminate_ray, ignore_ray_intersection, and the NIR-specific
+ * accept_ray_intersection intrinsics to the appropriate turnip-specific
+ * intrinsics.
+ */
+static bool
+lower_ray_walk_intrinsics(nir_shader *shader)
+{
+   assert(shader->info.stage == MESA_SHADER_ANY_HIT ||
+          shader->info.stage == MESA_SHADER_INTERSECTION);
+
+   nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+
+   nir_builder b = nir_builder_create(impl);
+
+   bool progress = false;
+   nir_foreach_block_safe(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+
+         switch (intrin->intrinsic) {
+         case nir_intrinsic_ignore_ray_intersection: {
+            b.cursor = nir_instr_remove(&intrin->instr);
+
+            /* We put the newly emitted code inside a dummy if because it's
+             * going to contain a jump instruction and we don't want to deal
+             * with that mess here.  It'll get dealt with by our control-flow
+             * optimization passes.
+             */
+            nir_push_if(&b, nir_imm_true(&b));
+
+            /* Call into the traversal shader to continue searching. */
+            nir_rt_spawn_thread_ir3(&b, nir_imm_int(&b, 0));
+            nir_jump(&b, nir_jump_halt);
+
+            nir_pop_if(&b, NULL);
+            progress = true;
+            break;
+         }
+
+         case nir_intrinsic_accept_ray_intersection: {
+            b.cursor = nir_instr_remove(&intrin->instr);
+
+            nir_def *terminate = nir_test_mask(&b, nir_load_ray_flags(&b),
+               TU_RAY_FLAG_TERMINATE_ON_FIRST_HIT);
+            nir_push_if(&b, terminate);
+            {
+               build_terminate_ray(&b);
+            }
+            nir_push_else(&b, NULL);
+            {
+               nir_rt_commit_hit_ir3(&b);
+               nir_rt_spawn_thread_ir3(&b, nir_imm_int(&b, 0));
+               nir_jump(&b, nir_jump_halt);
+            }
+            nir_pop_if(&b, NULL);
+            progress = true;
+            break;
+         }
+
+         case nir_intrinsic_terminate_ray: {
+            b.cursor = nir_instr_remove(&intrin->instr);
+
+            nir_push_if(&b, nir_imm_true(&b));
+            {
+               build_terminate_ray(&b);
+            }
+            nir_pop_if(&b, NULL);
+            progress = true;
+            break;
+         }
+
+         default:
+            break;
+         }
+      }
+   }
+
+   return nir_progress(progress, impl, nir_metadata_none);
+}
+
+UNUSED static bool
+no_load_scratch_base_ptr_intrinsic(nir_shader *shader)
+{
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+
+            nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+            if (intrin->intrinsic == nir_intrinsic_load_scratch_base_ptr)
+               return false;
+         }
+      }
+   }
+
+   return true;
+}
+
+/** Insert the appropriate return instruction at the end of the shader */
+static bool
+tu_nir_lower_shader_returns(nir_shader *shader)
+{
+   nir_function_impl *impl = nir_shader_get_entrypoint(shader);
+
+   /* Reserve scratch space at the start of the shader's per-thread scratch
+    * space for the return shader index and data payload.  When a shader is
+    * called, the calling shader will write the return index in this region of
+    * the callee's scratch space.
+    *
+    * We could also put it at the end of the caller's scratch space.  However,
+    * doing this way means that a shader never accesses its caller's scratch
+    * space unless given an explicit pointer (such as for ray payloads).  It
+    * also makes computing the address easier given that we want to apply an
+    * alignment to the scratch offset to ensure we can make alignment
+    * assumptions in the called shader.
+    *
+    * This isn't needed for ray-gen shaders because they end the thread and
+    * never return to the calling trampoline shader.
+    */
+   assert(no_load_scratch_base_ptr_intrinsic(shader));
+   if (shader->info.stage != MESA_SHADER_RAYGEN)
+      shader->scratch_size += TU_STACK_CALLEE_DATA_SIZE;
+
+   nir_builder b = nir_builder_create(impl);
+
+   nir_foreach_pred (block, impl->end_block) {
+      b.cursor = nir_after_block_before_jump(block);
+
+      switch (shader->info.stage) {
+      case MESA_SHADER_RAYGEN:
+         /* A raygen shader is always the root of the shader call tree.  When
+          * it ends, we terminate the thread.
+          */
+         nir_rt_terminate_thread_ir3(&b);
+         break;
+
+      case MESA_SHADER_ANY_HIT:
+         /* The default action of an any-hit shader is to accept the ray
+          * intersection.  Any-hit shaders may have more than one exit.  Only
+          * the final "normal" exit will actually need to accept the
+          * intersection as any others should come from nir_jump_halt
+          * instructions inserted after ignore_ray_intersection or
+          * terminate_ray or the like.  However, inserting an accept after
+          * the ignore or terminate is safe because it'll get deleted later.
+          */
+         nir_accept_ray_intersection(&b);
+         break;
+
+      case MESA_SHADER_CALLABLE:
+      case MESA_SHADER_MISS:
+      case MESA_SHADER_CLOSEST_HIT:
+         /* Callable, miss, and closest-hit shaders don't take any special
+          * action at the end.  They simply return back to the previous shader
+          * in the call stack.
+          */
+         tu_nir_rt_return(&b);
+         break;
+
+      case MESA_SHADER_INTERSECTION:
+         /* This will be handled by brw_nir_lower_intersection_shader */
+         break;
+
+      default:
+         UNREACHABLE("Invalid callable shader stage");
+      }
+   }
+
+   return nir_progress(true, impl, nir_metadata_control_flow);
+}
+
+void
+tu_nir_lower_raygen(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_RAYGEN);
+   NIR_PASS(_, nir, tu_nir_lower_shader_returns);
+   lower_rt_io_and_scratch(nir);
+}
+
+void
+tu_nir_lower_any_hit(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_ANY_HIT);
+   NIR_PASS(_, nir, tu_nir_lower_shader_returns);
+   NIR_PASS(_, nir, lower_ray_walk_intrinsics);
+   lower_rt_io_and_scratch(nir);
+}
+
+void
+tu_nir_lower_closest_hit(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_CLOSEST_HIT);
+   NIR_PASS(_, nir, tu_nir_lower_shader_returns);
+   lower_rt_io_and_scratch(nir);
+}
+
+void
+tu_nir_lower_miss(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_MISS);
+   NIR_PASS(_, nir, tu_nir_lower_shader_returns);
+   lower_rt_io_and_scratch(nir);
+}
+
+void
+tu_nir_lower_callable(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_CALLABLE);
+   NIR_PASS(_, nir, tu_nir_lower_shader_returns);
+   lower_rt_io_and_scratch(nir);
+}
+
+void
+tu_nir_lower_combined_intersection_any_hit(nir_shader *intersection,
+                                           const nir_shader *any_hit)
+{
+   assert(intersection->info.stage == MESA_SHADER_INTERSECTION);
+   assert(any_hit == NULL || any_hit->info.stage == MESA_SHADER_ANY_HIT);
+   NIR_PASS(_, intersection, tu_nir_lower_shader_returns);
+   NIR_PASS(_, intersection, nir_lower_intersection_shader);
+   NIR_PASS(_, intersection, nir_inline_any_hit_shader, any_hit);
+   NIR_PASS(_, intersection, lower_ray_walk_intrinsics);
+   lower_rt_io_and_scratch(intersection);
+}
+
+static nir_def *
+_get_rt_param(nir_builder *b, unsigned bit_size, unsigned offset)
+{
+   return nir_load_ubo(b, 1, bit_size, nir_imm_int(b, TU_RT_DRIVER_UBO),
+                       nir_imm_int(b, offset),
+                       .range = bit_size / 8);
+}
+
+#define get_rt_param(b, field) \
+   _get_rt_param(b, sizeof(((struct tu_rt_params *)0)->field) * 8, \
+                 offsetof(struct tu_rt_params, field))
+
+static nir_def *
+get_stack_size(nir_builder *b)
+{
+   return get_rt_param(b, stack_size);
+}
+
+static nir_def *
+get_counts_addr(nir_builder *b)
+{
+   return get_rt_param(b, counts_addr);
+}
+
+static nir_def *
+get_thread_ids_addr(nir_builder *b)
+{
+   return get_rt_param(b, pending_thread_ids_addr);
+}
+
+static nir_def *
+_get_sbt_field(nir_builder *b, unsigned offset)
+{
+   return nir_load_ubo(b, 1, 64, nir_imm_int(b, TU_RT_SBT_UBO),
+                       nir_imm_int(b, offset),
+                       .range = 8);
+}
+
+#define get_sbt_field(b, field) \
+   _get_sbt_field(b, offsetof(VkTraceRaysIndirectCommand2KHR, field))
+
+static void
+store_resume_addr(nir_builder *b, nir_intrinsic_instr *call,
+                  uint32_t shader_idx)
+{
+   uint32_t call_idx = nir_intrinsic_call_idx(call);
+   uint32_t offset = nir_intrinsic_stack_size(call);
+
+   /* First thing on the called shader's stack is a pointer to the payload
+    * followed by the resume index. Use relative addressing to get the resume
+    * index.
+    */
+   nir_def *resume_index =
+      nir_iadd_imm(b, nir_ishr_imm(b, nir_load_rt_cur_shader_bytes_ir3(b), 2),
+                   (call_idx + 1 - shader_idx));
+
+   /* By the time we get here, any remaining shader/function memory
+    * pointers have been lowered to SSA values.
+    */
+   nir_def *payload_addr =
+      nir_get_shader_call_payload_src(call)->ssa;
+   nir_def *payload_addr_vec2 = nir_unpack_64_2x32(b, payload_addr);
+   tu_nir_rt_store_scratch(b, offset, TU_STACK_ALIGN,
+                           nir_vec3(b,
+                                    nir_channel(b, payload_addr_vec2, 0),
+                                    nir_channel(b, payload_addr_vec2, 1),
+                                    resume_index),
+                            0xf /* write_mask */);
+
+   nir_rt_stack_push_ir3(b, offset);
+}
+
+static bool
+lower_shader_call(struct nir_builder *b, nir_intrinsic_instr *call,
+                  void *data)
+{
+   uint32_t shader_idx = *(uint32_t *)data;
+
+   if (call->intrinsic != nir_intrinsic_rt_trace_ray &&
+       call->intrinsic != nir_intrinsic_rt_execute_callable)
+      return false;
+
+   b->cursor = nir_after_instr(&call->instr);
+   store_resume_addr(b, call, shader_idx);
+
+   if (call->intrinsic == nir_intrinsic_rt_trace_ray) {
+      /* Go to the traversal shader */
+      nir_rt_spawn_thread_ir3(b, nir_imm_int(b, 0));
+   } else {
+      nir_def *sbt_offset32 =
+         nir_imul(b, call->src[0].ssa,
+                  nir_u2u32(b, get_sbt_field(b, callableShaderBindingTableStride)));
+      nir_def *sbt_addr =
+         nir_iadd(b, get_sbt_field(b, callableShaderBindingTableAddress),
+                  nir_u2u64(b, sbt_offset32));
+      nir_def *shader_record_ptr =
+         nir_iadd_imm(b, sbt_addr, TU_RT_HANDLE_SIZE);
+      nir_def *callable_idx = nir_load_global(b, 1, 32, sbt_addr,
+                                              .align_mul = 4);
+      nir_rt_store_shader_record_ptr_ir3(b, shader_record_ptr);
+      nir_rt_spawn_thread_ir3(b, callable_idx);
+      nir_instr_remove(&call->instr);
+   }
+
+   return true;
+}
+
+bool
+tu_nir_lower_shader_calls(nir_shader *shader, uint32_t shader_idx)
+{
+   return nir_shader_intrinsics_pass(shader,
+                                     lower_shader_call,
+                                     nir_metadata_none,
+                                     &shader_idx);
+}
+
+/* There are two scratch areas available to us. We use the first scratch area,
+ * scratch0, for shader-independent data, which is preallocated and always has
+ * the same layout. scratch1 contains the shader stack.
+ *
+ * The layout of scratch0 is as follows: a "hot zone" inspired by Intel, which
+ * contains the stack pointer and global ID for each thread, followed by a
+ * traversal structure per thread which acts as the interface between the
+ * traversal shader and the other shaders. The hot zone is split out so that
+ * HW can better coalesce the critical initial load of the stack pointer. The
+ * traversal structure is mostly the same as the ray query structure, with the
+ * addition of the hit kind and hit attributes.
+ */
+
+#define TU_HOTZONE_DWORDS 4
+
+enum rt_hotzone_var_index {
+   rt_hotzone_stack_ptr,
+   rt_hotzone_global_x,
+   rt_hotzone_global_y,
+   rt_hotzone_global_z,
+};
+
+enum rt_traversal_var_index {
+   rt_traversal_rq,
+   rt_traversal_shader_record_ptr,
+   rt_traversal_miss_index,
+   rt_traversal_sbt_offset,
+   rt_traversal_sbt_stride,
+   rt_traversal_ray_flags,
+   rt_traversal_hit_attr,
+   rt_traversal_hit_kind,
+};
+
+static const glsl_type *
+get_rt_traversal_type(unsigned *size)
+{
+   unsigned alignment;
+   struct glsl_struct_field fields[] = {
+#define FIELD(_type, _name) \
+      [rt_traversal_##_name] = glsl_struct_field(_type, #_name),
+      FIELD(tu_get_rq_type(), rq)
+      FIELD(glsl_uint64_t_type(), shader_record_ptr)
+      FIELD(glsl_uint16_t_type(), miss_index)
+      FIELD(glsl_uint8_t_type(), sbt_offset)
+      FIELD(glsl_uint8_t_type(), sbt_stride)
+      FIELD(glsl_uint_type(), ray_flags)
+      FIELD(glsl_array_type(glsl_uint_type(), TU_RT_MAX_HIT_ATTR_SIZE / 4, 0), hit_attr)
+      FIELD(glsl_uint_type(), hit_kind)
+#undef FIELD
+   };
+
+   const glsl_type *type =
+      glsl_struct_type(fields, ARRAY_SIZE(fields), "rt_traversal", false);
+   return glsl_get_explicit_type_for_size_align(type,
+                                                glsl_get_natural_size_align_bytes,
+                                                size, &alignment);
+}
+
+#define rt_deref(b, _rt, name) nir_build_deref_struct(b, _rt, rt_traversal_##name)
+#define rt_load(b, _rt, name) nir_load_deref(b, rt_deref(b, _rt, name))
+#define rt_store(b, _rt, name, val, wrmask) \
+   nir_store_deref(b, rt_deref(b, _rt, name), val, wrmask)
+
+static nir_deref_instr *
+get_traversal_data(nir_builder *b, nir_def *thread_id)
+{
+   unsigned stride;
+   const glsl_type *type = get_rt_traversal_type(&stride);
+
+   nir_def *scratch0 = nir_pack_64_2x32(b, nir_load_rt_scratch0_ir3(b));
+   nir_def *max_threads = nir_load_rt_max_active_threads_ir3(b);
+
+   nir_def *offset = nir_imul_imm(b, max_threads, TU_HOTZONE_DWORDS * 4);
+   offset = nir_iadd(b, offset, nir_imul24(b, thread_id, nir_imm_int(b, stride)));
+
+   nir_def *ptr = nir_iadd(b, scratch0, nir_u2u64(b, offset));
+   return nir_build_deref_cast(b, ptr, nir_var_mem_global, type, stride);
+}
+
+static nir_def *
+get_hotzone_ptr(nir_builder *b, nir_def *thread_id)
+{
+   nir_def *scratch0 = nir_pack_64_2x32(b, nir_load_rt_scratch0_ir3(b));
+
+   nir_def *offset = nir_imul_imm(b, thread_id, TU_HOTZONE_DWORDS * 4);
+   return nir_iadd(b, scratch0, nir_u2u64(b, offset));
+}
+
+static nir_def *
+get_rt_stack_addr(nir_builder *b, nir_def *thread_id)
+{
+   nir_def *scratch1 = nir_pack_64_2x32(b, nir_load_rt_scratch1_ir3(b));
+
+   nir_def *offset = nir_imul(b, nir_u2u64(b, get_stack_size(b)),
+                              nir_u2u64(b, thread_id));
+   return nir_iadd(b, scratch1, offset);
+}
+
+/* Get the global invocation index, assuming the dispatch is one-dimensional.
+ */
+static nir_def *
+tu_rt_load_invocation_index(nir_builder *b)
+{
+   return nir_iadd(b, nir_imul(b, nir_channel(b, nir_load_workgroup_id(b), 0),
+                               nir_channel(b, nir_load_workgroup_size(b), 0)),
+                   nir_load_local_invocation_index(b));
+}
+
+static nir_def *
+get_thread_id(nir_builder *b)
+{
+   nir_def *thread_ids =
+      nir_pack_64_2x32(b, nir_load_rt_cur_slot_thread_ids_ir3(b));
+   nir_def *invocation_id = tu_rt_load_invocation_index(b);
+   nir_def *offset = nir_imul_imm(b, invocation_id, 2);
+   nir_def *ptr = nir_iadd(b, thread_ids, nir_u2u64(b, offset));
+   return nir_u2u32(b, nir_load_global(b, 1, 16, ptr, .align_mul = 2));
+}
+
+/** HitKind values returned for triangle geometry
+ *
+ * This enum must match the SPIR-V enum.
+ */
+enum brw_rt_hit_kind {
+   TU_RT_HIT_KIND_FRONT_FACE = 0xfe,
+   TU_RT_HIT_KIND_BACK_FACE = 0xff,
+};
+
+static bool
+lower_rt_intrinsics_impl(nir_function_impl *impl, unsigned shader_idx,
+                         uint32_t pipeline_ray_flags)
+{
+   nir_builder build = nir_builder_at(nir_before_impl(impl));
+   nir_builder *b = &build;
+
+   mesa_shader_stage stage = b->shader->info.stage;
+
+   nir_def *thread_id;
+   if (stage == MESA_SHADER_RAYGEN && shader_idx == 0) {
+      thread_id = tu_rt_load_invocation_index(b);
+   } else {
+      thread_id = get_thread_id(b);
+   }
+
+   nir_def *hotzone_addr = get_hotzone_ptr(b, thread_id);
+   nir_def *hotzone;
+   if (stage == MESA_SHADER_RAYGEN && shader_idx == 0) {
+      /* The initial raygen shader is first thing that gets executed each
+       * round. Initialize the hotzone.
+       */
+      nir_def *global_counters =
+         nir_pack_64_2x32(b, nir_load_rt_global_counts_ir3(b));
+      nir_def *offset =
+         nir_load_global_ir3(b, 1, 32, global_counters, nir_imm_int(b, 4),
+                             .access = (enum gl_access_qualifier)(
+                                ACCESS_NON_WRITEABLE |
+                                ACCESS_CAN_REORDER |
+                                ACCESS_CAN_SPECULATE));
+      nir_def *linear_invocation_id =
+         nir_iadd(b, nir_iadd(b, thread_id, offset),
+                  nir_load_rt_context_thread_offset_ir3(b));
+
+      /* Compute the 3D id from the 1D id */
+      nir_def *size = nir_load_ray_launch_size(b);
+      nir_def *invocation_id[3];
+      for (unsigned i = 0; i < 2; i++) {
+         nir_def *divided_id = nir_idiv(b, linear_invocation_id,
+                                        nir_channel(b, size, i));
+         invocation_id[i] = nir_isub(b, linear_invocation_id,
+                                     nir_imul(b, divided_id,
+                                              nir_channel(b, size, i)));
+         linear_invocation_id = divided_id;
+      }
+      invocation_id[2] = linear_invocation_id;
+
+      hotzone = nir_vec4(b, nir_imm_int(b, 0),
+                         invocation_id[0], invocation_id[1],
+                         invocation_id[2]);
+      nir_store_global(b, hotzone, hotzone_addr,
+                       .write_mask = 0b1111,
+                       .align_mul = 16);
+   } else {
+      hotzone = nir_load_global(b, 4, 32, hotzone_addr, .align_mul = 16);
+   }
+   nir_deref_instr *traversal_data_in = get_traversal_data(b, thread_id);
+
+   nir_variable *traversal_data_var =
+      nir_local_variable_create(impl, traversal_data_in->type,
+                                "traversal_data");
+   nir_deref_instr *traversal_data =
+      nir_build_deref_var(b, traversal_data_var);
+
+   nir_copy_deref(b, traversal_data, traversal_data_in);
+
+   nir_deref_instr *rq = rt_deref(b, traversal_data, rq);
+   nir_def *tlas = rq_load(b, rq, accel_struct_base);
+   nir_deref_instr *closest = rq_deref(b, rq, closest);
+   nir_deref_instr *candidate = rq_deref(b, rq, candidate);
+   nir_deref_instr *rqi =
+      (stage == MESA_SHADER_CLOSEST_HIT) ? closest : candidate;
+
+   nir_def *thread_stack_base_addr = get_rt_stack_addr(b, thread_id);
+   nir_def *stack_base_offset = nir_channel(b, hotzone, 0);
+   nir_def *stack_base_addr =
+      nir_iadd(b, thread_stack_base_addr, nir_u2u64(b, stack_base_offset));
+   ASSERTED bool seen_scratch_base_ptr_load = false;
+
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+
+         nir_intrinsic_instr *intrin = nir_instr_as_intrinsic(instr);
+
+         b->cursor = nir_after_instr(&intrin->instr);
+
+         nir_def *sysval = NULL;
+         switch (intrin->intrinsic) {
+         case nir_intrinsic_load_scratch_base_ptr:
+            assert(nir_intrinsic_base(intrin) == 1);
+            seen_scratch_base_ptr_load = true;
+            sysval = stack_base_addr;
+            break;
+
+         case nir_intrinsic_rt_stack_push_ir3: {
+            int32_t stack_size = nir_intrinsic_stack_size(intrin);
+            if (stack_size > 0) {
+               nir_def *child_stack_offset =
+                  nir_iadd_imm(b, stack_base_offset, stack_size);
+               nir_store_global(b, child_stack_offset, hotzone_addr,
+                                .write_mask = 0x1,
+                                .align_mul = 16);
+            }
+            nir_instr_remove(instr);
+            break;
+         }
+
+         case nir_intrinsic_rt_resume: {
+            /* This is the first "interesting" instruction */
+            assert(block == nir_start_block(impl));
+            assert(!seen_scratch_base_ptr_load);
+            assert(shader_idx != 0);
+
+            /* Pop the stack after returning from the callee. */
+            int32_t stack_size = nir_intrinsic_stack_size(intrin);
+            if (stack_size > 0) {
+               stack_base_offset =
+                  nir_iadd_imm(b, stack_base_offset, -stack_size);
+               nir_store_global(b, stack_base_offset, hotzone_addr,
+                                .write_mask = 0x1,
+                                .align_mul = 16);
+               stack_base_addr = nir_iadd(b, thread_stack_base_addr,
+                                          nir_u2u64(b, stack_base_offset));
+            }
+            nir_instr_remove(instr);
+            break;
+         }
+
+         case nir_intrinsic_load_ray_launch_id:
+            sysval = nir_channels(b, hotzone, 0xe);
+            break;
+
+         case nir_intrinsic_load_ray_world_origin:
+            sysval = rq_load(b, rq, world_origin);
+            break;
+
+         case nir_intrinsic_load_ray_world_direction:
+            sysval = rq_load(b, rq, world_direction);
+            break;
+
+         case nir_intrinsic_load_ray_object_origin:
+            sysval = rqi_load(b, rqi, origin);
+            break;
+
+         case nir_intrinsic_load_ray_object_direction:
+            sysval = rqi_load(b, rqi, direction);
+            break;
+
+         case nir_intrinsic_load_ray_t_min:
+            sysval = rq_load(b, rq, tmin);
+            break;
+
+         case nir_intrinsic_load_ray_t_max:
+            if (stage == MESA_SHADER_MISS || stage == MESA_SHADER_INTERSECTION)
+               sysval = rqi_load(b, closest, t);
+            else
+               sysval = rqi_load(b, rqi, t);
+            break;
+
+         case nir_intrinsic_load_primitive_id:
+            sysval = rqi_load(b, rqi, primitive_id);
+            break;
+
+         case nir_intrinsic_load_instance_id:
+            sysval = rqi_load(b, rqi, instance);
+            break;
+
+         case nir_intrinsic_load_ray_object_to_world: {
+            unsigned column = nir_intrinsic_column(intrin);
+            nir_def *instance = rqi_load(b, rqi, instance);
+            nir_def *rows[3];
+            for (unsigned r = 0; r < 3; ++r)
+               rows[r] = tu_load_instance_offset(b, tlas, NULL, instance,
+                                                 otw_matrix.values,
+                                                 r * 16, 4);
+            sysval = nir_vec3(b, nir_channel(b, rows[0], column),
+                              nir_channel(b, rows[1], column),
+                              nir_channel(b, rows[2], column));
+            break;
+         }
+
+         case nir_intrinsic_load_ray_world_to_object: {
+            unsigned column = nir_intrinsic_column(intrin);
+            nir_def *instance = rqi_load(b, rqi, instance);
+            nir_def *rows[3];
+            for (unsigned r = 0; r < 3; ++r)
+               rows[r] = tu_load_instance_offset(b, tlas, NULL, instance,
+                                                 wto_matrix.values, r * 16, 4);
+
+            sysval = nir_vec3(b, nir_channel(b, rows[0], column),
+                              nir_channel(b, rows[1], column),
+                              nir_channel(b, rows[2], column));
+            break;
+         }
+
+         case nir_intrinsic_load_ray_hit_kind: {
+            nir_def *type_flags = rqi_load(b, rqi, type_flags);
+            nir_def *is_aabb =
+               nir_test_mask(b, type_flags,
+                             TU_INTERSECTION_TYPE_AABB);
+            nir_def *back_face =
+               nir_test_mask(b, type_flags, TU_INTERSECTION_BACK_FACE);
+            nir_def *tri_hit_kind =
+               nir_bcsel(b, back_face,
+                            nir_imm_int(b, TU_RT_HIT_KIND_BACK_FACE),
+                            nir_imm_int(b, TU_RT_HIT_KIND_FRONT_FACE));
+            sysval = nir_bcsel(b, is_aabb,
+                               rt_load(b, traversal_data, hit_kind),
+                               tri_hit_kind);
+            break;
+         }
+
+         case nir_intrinsic_load_ray_flags:
+            /* We need to fetch the original ray flags we stored in the
+             * traversal struct, because the actual ray flags we get here
+             * will include any flags passed on the pipeline at creation
+             * time, and the spec for IncomingRayFlagsKHR says:
+             *   Setting pipeline flags on the raytracing pipeline must not
+             *   cause any corresponding flags to be set in variables with
+             *   this decoration.
+             */
+            sysval = rt_load(b, traversal_data, ray_flags);
+            break;
+
+         case nir_intrinsic_load_cull_mask:
+            sysval = nir_ushr_imm(b, rq_load(b, rq, flags), 16);
+            break;
+
+         case nir_intrinsic_load_ray_geometry_index:
+            sysval = rqi_load(b, rqi, geometry_id);
+            break;
+
+         case nir_intrinsic_load_ray_instance_custom_index: {
+            nir_def *instance = rqi_load(b, rqi, instance);
+            sysval = tu_load_instance(b, tlas, NULL, instance,
+                                      custom_instance_index, 1);
+            break;
+         }
+
+         case nir_intrinsic_load_shader_record_ptr:
+            if (b->shader->info.stage == MESA_SHADER_RAYGEN) {
+               /* For raygen shaders, we get the SBT address directly from the
+                * UBO passed by the driver.
+                */
+               nir_def *sbt_addr =
+                  get_sbt_field(b, raygenShaderRecordAddress);
+               sysval = nir_iadd_imm(b, sbt_addr, TU_RT_HANDLE_SIZE);
+            } else {
+               /* Otherwise get it from the traversal shader or caller. */
+               assert(shader_idx == 0);
+               sysval = rt_load(b, traversal_data, shader_record_ptr);
+            }
+            break;
+
+         case nir_intrinsic_rt_store_shader_record_ptr_ir3: {
+            nir_def *ptr = intrin->src[0].ssa;
+            rt_store(b, traversal_data_in, shader_record_ptr, ptr, 0x1);
+            nir_instr_remove(instr);
+            break;
+         }
+            
+         case nir_intrinsic_load_rt_hit_attributes_addr_ir3: {
+            nir_deref_instr *aabb_deref =
+               rt_deref(b, traversal_data_in, hit_attr);
+            nir_def *aabb_addr = &aabb_deref->def;
+
+            if (b->shader->info.stage == MESA_SHADER_INTERSECTION) {
+               /* In intersection shaders, we know the current primitive is an
+                * AABB.
+                */
+               sysval = aabb_addr;
+            } else if (b->shader->info.stage == MESA_SHADER_ANY_HIT) {
+               /* In any-hit shaders that weren't inlined, it's the
+                * barycentrics for the current candidate triangle.
+                */
+               nir_deref_instr *tri_deref =
+                  rqi_deref(b, rq_deref(b, rt_deref(b, traversal_data_in, rq),
+                                        candidate), barycentrics);
+               nir_def *tri_addr = &tri_deref->def;
+               sysval = tri_addr;
+            } else {
+               assert(b->shader->info.stage == MESA_SHADER_CLOSEST_HIT);
+               /* In closest-hit shaders, it could be the AABB data or the
+                * barycentrics for the closest triangle, depending on whether
+                * the closest hit was a triangle or AABB.
+                */
+               nir_deref_instr *tri_deref =
+                  rqi_deref(b, rq_deref(b, rt_deref(b, traversal_data_in, rq),
+                                        closest), barycentrics);
+               nir_def *tri_addr = &tri_deref->def;
+               
+               nir_def *type_flags = rqi_load(b, rqi, type_flags);
+               nir_def *is_aabb = nir_test_mask(b, type_flags,
+                                                TU_INTERSECTION_TYPE_AABB);
+               sysval = nir_bcsel(b, is_aabb, aabb_addr, tri_addr);
+            }
+
+            break;
+         }
+
+         case nir_intrinsic_write_ray_intersection: {
+            nir_def *hit_t = intrin->src[0].ssa;
+            nir_def *hit_kind = intrin->src[1].ssa;
+            rt_store(b, traversal_data_in, hit_kind, hit_kind, 0x1);
+            /* After this, the candidate is copied to the the closest */
+            rqi_store(b, rq_deref(b, rt_deref(b, traversal_data_in, rq),
+                                  candidate), t, hit_t, 0x1);
+            nir_instr_remove(instr);
+            break;
+         }
+
+         case nir_intrinsic_rt_commit_hit_ir3: {
+            nir_deref_instr *rq_in = rt_deref(b, traversal_data_in, rq);
+            nir_deref_instr *candidate = rq_deref(b, rq_in, candidate);
+            nir_deref_instr *closest = rq_deref(b, rq_in, closest);
+            nir_copy_deref(b, closest, candidate);
+            nir_instr_remove(instr);
+            break;
+         }
+
+         case nir_intrinsic_rt_trace_ray: {
+            nir_deref_instr *rq = rt_deref(b, traversal_data_in, rq);
+
+            nir_def *as_ptr = intrin->src[0].ssa;
+            nir_def *ray_flags = intrin->src[1].ssa;
+            /* From the SPIR-V spec:
+             *
+             *    "Only the 8 least-significant bits of Cull Mask are used by this
+             *    instruction - other bits are ignored.
+             *
+             *    Only the 4 least-significant bits of SBT Offset and SBT Stride are
+             *    used by this instruction - other bits are ignored.
+             *
+             *    Only the 16 least-significant bits of Miss Index are used by this
+             *    instruction - other bits are ignored."
+             */
+            nir_def *cull_mask = nir_iand_imm(b, intrin->src[2].ssa, 0xff);
+            nir_def *sbt_offset = nir_u2u8(b, nir_iand_imm(b, intrin->src[3].ssa, 0xf));
+            nir_def *sbt_stride = nir_u2u8(b, nir_iand_imm(b, intrin->src[4].ssa, 0xf));
+            nir_def *miss_index = nir_u2u16(b, intrin->src[5].ssa);
+            nir_def *ray_orig = intrin->src[6].ssa;
+            nir_def *ray_t_min = intrin->src[7].ssa;
+            nir_def *ray_dir = intrin->src[8].ssa;
+            nir_def *ray_t_max = intrin->src[9].ssa;
+
+            nir_def *uav_index;
+            if (nir_def_instr(as_ptr)->type == nir_instr_type_intrinsic &&
+                nir_instr_as_intrinsic(nir_def_instr(as_ptr))->intrinsic ==
+                nir_intrinsic_load_vulkan_descriptor) {
+               uav_index = as_ptr;
+            } else {
+               uav_index = NULL;
+            }
+
+            nir_def *tlas_base;
+            if (uav_index) {
+               tlas_base = tu_load_tlas(b, NULL, uav_index, nir_imm_int(b, 0),
+                                        offsetof(struct tu_accel_struct_header,
+                                                 self_ptr), 2);
+            } else {
+               tlas_base = nir_unpack_64_2x32(b, as_ptr);
+            }
+
+            rq_store(b, rq, accel_struct_base, tlas_base, 0x3);
+
+            nir_def *root_bvh_base = tu_load_tlas(b, tlas_base, uav_index, nir_imm_int(b, 0),
+                                                  offsetof(struct tu_accel_struct_header,
+                                                           bvh_ptr), 2);
+
+            nir_deref_instr *closest = rq_deref(b, rq, closest);
+            nir_deref_instr *candidate = rq_deref(b, rq, candidate);
+
+            rt_store(b, traversal_data_in, ray_flags, ray_flags, 0x1);
+
+            ray_flags = nir_ior_imm(b, ray_flags, pipeline_ray_flags);
+
+            /* The Vulkan spec says that SkipTrianglesKHR is mutually
+             * exclusive with CullBackFacingTrianglesKHR and
+             * CullFrontFacingTrianglesKHR, and the hardware seems to rely on
+             * this. It will ignore SkipTrianglesKHR if one of
+             * Cull*FacingTrianglesKHR is set. However the spec doesn't
+             * explicitly say the same about
+             * VK_PIPELINE_CREATE_RAY_TRACING_SKIP_TRIANGLES_BIT_KHR, only
+             * saying that "traversal with pipeline trace ray instructions
+             * will all behave as if SkipTrianglesKHR was included in their
+             * Ray Flags operand." Therefore we have to manually remove these
+             * flags if triangle skipping is enabled in the pipeline.
+             */
+            if (pipeline_ray_flags & SpvRayFlagsSkipTrianglesKHRMask) {
+               ray_flags = nir_iand_imm(b, ray_flags,
+                                        ~(SpvRayFlagsCullBackFacingTrianglesKHRMask |
+                                          SpvRayFlagsCullFrontFacingTrianglesKHRMask));
+            }
+
+            rq_store(b, rq, flags,
+                     /* Fill out initial fourth src of ray_intersection */
+                     nir_ior_imm(b,
+                                 nir_ior(b, nir_ishl_imm(b, ray_flags, 4),
+                                         nir_ishl_imm(b, cull_mask, 16)),
+                                 0b1111), 0x1);
+
+            rqi_store(b, candidate, origin, ray_orig, 0x7);
+            rqi_store(b, candidate, direction, ray_dir, 0x7);
+
+            rq_store(b, rq, tmin, ray_t_min, 0x1);
+            rq_store(b, rq, world_origin, ray_orig, 0x7);
+            rq_store(b, rq, world_direction, ray_dir, 0x7);
+
+            rqi_store(b, closest, t, ray_t_max, 0x1);
+            rqi_store(b, closest, type_flags, nir_imm_int(b, TU_INTERSECTION_TYPE_NO_INTERSECTION), 0x1);
+
+            /* Make sure that instance data loads don't hang in case of a miss
+             * by setting a valid initial instance.
+             */
+            rqi_store(b, closest, instance, nir_imm_int(b, 0), 0x1);
+            rqi_store(b, candidate, instance, nir_imm_int(b, 0), 0x1);
+
+            rq_store(b, rq, root_bvh_base, root_bvh_base, 0x3);
+            rq_store(b, rq, bvh_base, root_bvh_base, 0x3);
+
+            rq_store(b, rq, stack_ptr, nir_imm_int(b, 0), 0x1);
+            rq_store(b, rq, top_stack, nir_imm_int(b, -1), 0x1);
+            rq_store(b, rq, stack_low_watermark, nir_imm_int(b, 0), 0x1);
+            rq_store(b, rq, current_node, nir_imm_int(b, 0), 0x1);
+            rq_store(b, rq, previous_node, nir_imm_int(b, VK_BVH_INVALID_NODE), 0x1);
+            rq_store(b, rq, instance_top_node, nir_imm_int(b, VK_BVH_INVALID_NODE), 0x1);
+            rq_store(b, rq, instance_bottom_node, nir_imm_int(b, VK_BVH_INVALID_NODE), 0x1);
+
+            rq_store(b, rq, incomplete, nir_imm_true(b), 0x1);
+
+            rt_store(b, traversal_data_in, miss_index, miss_index, 0x1);
+            rt_store(b, traversal_data_in, sbt_offset, sbt_offset, 0x1);
+            rt_store(b, traversal_data_in, sbt_stride, sbt_stride, 0x1);
+
+            nir_instr_remove(instr);
+            break;
+         }
+
+         case nir_intrinsic_rt_spawn_thread_ir3: {
+            nir_def *shader = intrin->src[0].ssa;
+            nir_def *shader_to_slot =
+               nir_pack_64_2x32(b, nir_load_rt_shader_to_slot_ir3(b));
+            /* Map the shader index to its current slot */
+            nir_def *slot =
+               nir_load_global_ir3(b, 1, 32, shader_to_slot,
+                                   nir_imul_imm(b, shader, 4),
+                                   .access = (enum gl_access_qualifier)(
+                                   ACCESS_NON_WRITEABLE |
+                                   ACCESS_CAN_REORDER |
+                                   ACCESS_CAN_SPECULATE));
+            nir_def *count_addr =
+               nir_iadd(b, get_counts_addr(b),
+                        nir_u2u64(b, nir_imul_imm(b, slot, 4)));
+
+            /* Increment the count of pending threads read by the AQE. */
+            nir_def *thread_idx_offset =
+               nir_global_atomic(b, 32, count_addr, nir_imm_int(b, 1),
+                                 .access = ACCESS_CROSS_DEVICE,
+                                 .atomic_op = nir_atomic_op_iadd);
+
+            /* We need to mimic what the AQE does to calculate
+             * cur_slot_thread_ids to get the pointer to the thread_ids for
+             * the next slot.
+             */
+            nir_def *pending_thread_ids = get_thread_ids_addr(b);
+            nir_def *max_active_threads =
+               nir_load_rt_max_active_threads_ir3(b);
+            nir_def *stride =
+               nir_iand_imm(b,
+                  nir_iadd_imm(b, nir_imul_imm(b, max_active_threads, 2), 2),
+                  ~0x3);
+            nir_def *slot_thread_ids =
+               nir_iadd(b, pending_thread_ids,
+                        nir_imul(b, nir_u2u64(b, stride), nir_u2u64(b, slot)));
+            nir_def *thread_id_ptr =
+               nir_iadd(b, slot_thread_ids,
+                        nir_u2u64(b, nir_imul_imm(b, thread_idx_offset, 2)));
+
+            /* Finally, store the thread ID. It will be read from
+             * cur_slot_thread_ids when the shader gets executed.
+             */
+            nir_store_global(b, nir_u2u16(b, thread_id), thread_id_ptr,
+                             .write_mask = 0x1,
+                             .align_mul = 2);
+
+            nir_barrier(b, .execution_scope = SCOPE_INVOCATION,
+                        .memory_scope = SCOPE_DEVICE,
+                        .memory_semantics = NIR_MEMORY_RELEASE,
+                        .memory_modes = nir_var_mem_global);
+
+            nir_instr_remove(instr);
+            break;
+         }
+
+         case nir_intrinsic_rt_terminate_thread_ir3: {
+            assert(b->shader->info.stage == MESA_SHADER_RAYGEN);
+            nir_def *max_active_threads =
+               nir_load_rt_max_active_threads_ir3(b);
+            nir_def *global_counters =
+               nir_pack_64_2x32(b, nir_load_rt_global_counts_ir3(b));
+            nir_def *terminated_count =
+               nir_global_atomic(b, 32, global_counters, nir_imm_int(b, 1),
+                                 .access = ACCESS_CROSS_DEVICE,
+                                 .atomic_op = nir_atomic_op_iadd);
+
+            /* convert to post-increment to get the count of threads
+             * terminated including this one.
+             */
+            terminated_count = nir_iadd_imm(b, terminated_count, 1);
+
+            /* Get the starting offset for the current chunk. */
+            nir_def *offset =
+               nir_load_global_ir3(b, 1, 32, global_counters, nir_imm_int(b, 4),
+                                   .access = (enum gl_access_qualifier)(
+                                      ACCESS_NON_WRITEABLE |
+                                      ACCESS_CAN_REORDER |
+                                      ACCESS_CAN_SPECULATE));
+
+            /* Check if all threads for this chunk have terminated */
+            nir_push_if(b, nir_ieq(b, terminated_count,
+                                   nir_iadd(b, offset, max_active_threads)));
+            {
+               nir_def *context_threads = nir_load_rt_context_threads_ir3(b);
+               nir_def *next_offset =
+                  nir_umin(b, nir_iadd(b, offset, max_active_threads),
+                           context_threads);
+
+               /* Increment the offset. Use stthr so that when the AQE
+                * re-initializes global_counters in the next CmdTraceRays() we
+                * don't run into stale data in the cache.
+                */
+               nir_store_global_ir3(b, next_offset, global_counters,
+                                    nir_imm_int(b, 4),
+                                    .access = ACCESS_NON_TEMPORAL);
+
+               /* Get the index of the initial raygen shader multiplied by 4,
+                * turning it into a byte offset into shader_to_slot. The AQE
+                * helps us out by multiplying the current shader index by 4,
+                * saving us a shift.
+                */
+               nir_def *cur_shader_bytes = nir_load_rt_cur_shader_bytes_ir3(b);
+               nir_def *shader_bytes = nir_iadd_imm(b, cur_shader_bytes,
+                                                    -shader_idx * 4);
+
+               /* Get the slot for the initial raygen shader */
+               nir_def *shader_to_slot =
+                  nir_pack_64_2x32(b, nir_load_rt_shader_to_slot_ir3(b));
+               nir_def *slot =
+                  nir_load_global_ir3(b, 1, 32, shader_to_slot,
+                                      shader_bytes,
+                                      .access = (enum gl_access_qualifier)(
+                                      ACCESS_NON_WRITEABLE |
+                                      ACCESS_CAN_REORDER |
+                                      ACCESS_CAN_SPECULATE),
+                                      .align_mul = 4,
+                                      .align_offset = 0);
+
+               /* Get the number of threads to launch. We launch up to
+                * max_active_threads, less if this is the last chunk.
+                */
+               nir_def *next_count =
+                  nir_umin(b, max_active_threads, 
+                           nir_isub(b, context_threads, next_offset));
+
+               /* Finally, tell the AQE to execute the raygen shader */
+               nir_def *slot_count =
+                  nir_iadd(b, get_counts_addr(b),
+                           nir_u2u64(b, nir_imul_imm(b, slot, 4)));
+
+               nir_global_atomic(b, 32, slot_count, next_count,
+                                 .access = ACCESS_CROSS_DEVICE,
+                                 .atomic_op = nir_atomic_op_iadd);
+
+               nir_barrier(b, .execution_scope = SCOPE_INVOCATION,
+                           .memory_scope = SCOPE_DEVICE,
+                           .memory_semantics = NIR_MEMORY_RELEASE,
+                           .memory_modes = nir_var_mem_global);
+            }
+            nir_pop_if(b, NULL);
+
+            nir_instr_remove(instr);
+            break;
+         }
+
+         case nir_intrinsic_load_leaf_opaque: {
+            nir_def *type_flags = rqi_load(b, rqi, type_flags);
+            sysval = nir_inot(b, nir_test_mask(b, type_flags,
+                                               TU_INTERSECTION_TYPE_NONOPAQUE));
+            break;
+         }
+
+         default:
+            continue;
+         }
+
+         if (sysval) {
+            nir_def_replace(&intrin->def, sysval);
+         }
+      }
+   }
+
+   return nir_progress(true, impl, nir_metadata_none);
+}
+
+static void
+create_rt_preamble(nir_shader *nir)
+{
+   nir_function_impl *preamble = nir_shader_get_preamble(nir);
+
+   nir_builder _b = nir_builder_at(nir_before_impl(preamble)), *b = &_b;
+
+   nir_def *shader_to_slot =
+      nir_pack_64_2x32(b, nir_load_rt_shader_to_slot_ir3(b));
+
+   nir_def *cur_shader_bytes = nir_load_rt_cur_shader_bytes_ir3(b);
+
+   /* Before the AQE executes this shader, it will overwrite
+    * slot_to_shader[cur_shader] when it plays its shell game with slots.
+    * Invalidate this address in CCHE/UCHE in the preamble. This means that we
+    * don't have to invalidate the entire cache.
+    */
+   nir_invalidate_address_ir3(b, shader_to_slot, cur_shader_bytes,
+                              .align_mul = 4,
+                              .bit_size = 32,
+                              .num_components = 1);
+
+   nir_progress(true, preamble, nir_metadata_control_flow);
+}
+
+/** Lower ray-tracing system values and intrinsics
+ *
+ * In most 3D shader stages, intrinsics are a fairly thin wrapper around
+ * hardware functionality and system values represent magic bits that come
+ * into the shader from FF hardware.  Ray-tracing, however, looks a bit more
+ * like the OpenGL 1.0 world where the underlying hardware is simple and most
+ * of the API implementation is software.
+ *
+ * In particular, most things that are treated as system values (or built-ins
+ * in SPIR-V) don't get magically dropped into registers for us.  Instead, we
+ * have to fetch them from the relevant data structures shared with the
+ * traversal shader. Some, such as instance_custom_index require us to look up
+ * data from the instance descriptor. Instead of trying to emit all this code
+ * deep in the back-end where we can't effectively optimize it, we lower it
+ * all to global memory access in NIR.
+ *
+ * Once this pass is complete, the only real system values left are the
+ * system values passed by the AQE to the compute shader.
+ */
+
+bool
+tu_nir_lower_rt_intrinsics(nir_shader *nir, unsigned shader_idx,
+                           uint32_t pipeline_ray_flags)
+{
+   nir_foreach_function_impl(impl, nir) {
+      lower_rt_intrinsics_impl(impl, shader_idx, pipeline_ray_flags);
+   }
+
+   create_rt_preamble(nir);
+
+   /* Now that we're done lowering things, transmorgify this into a compute
+    * shader so that ir3 doesn't have to understand RT shader types.
+    */
+   nir->info.stage = MESA_SHADER_COMPUTE;
+
+   /* The workgroup size is defined by AQE */
+   nir->info.workgroup_size_variable = false;
+   nir->info.workgroup_size[0] = 64;
+   nir->info.workgroup_size[1] = 1;
+   nir->info.workgroup_size[2] = 1;
+
+   /* Add the driver UBOs */
+   assert(nir->info.num_ubos == 0);
+   nir->info.num_ubos = TU_RT_NUM_UBOS;
+
+   return true;
+}
+
+/* Implement the hit shader indexing formula in Chapter 40 "Ray Tracing",
+ * section 3.1.
+ */
+static nir_def *
+get_hit_sbt_addr(nir_builder *b, nir_deref_instr *traversal_data,
+                 bool committed)
+{
+   nir_deref_instr *rq = rt_deref(b, traversal_data, rq);
+   nir_deref_instr *rqi = committed ?
+      rq_deref(b, rq, closest) : rq_deref(b, rq, candidate);
+   nir_def *index =
+      nir_iadd(b, rqi_load(b, rqi, sbt_offset),
+               nir_iadd(b, nir_imul(b, rqi_load(b, rqi, geometry_id),
+                                    nir_u2u32(b, rt_load(b, traversal_data,
+                                                         sbt_stride))),
+                        nir_u2u32(b, rt_load(b, traversal_data,
+                                             sbt_offset))));
+   return nir_iadd(b, get_sbt_field(b, hitShaderBindingTableAddress),
+                   nir_u2u64(b,
+                             nir_imul(b, nir_u2u32(b, get_sbt_field(b, hitShaderBindingTableStride)),
+                                      index)));
+}
+
+/* The traversal shader, which is always the first shader, is the shader
+ * that actually calls ray_intersection and walks the BVH tree. 
+ */
+
+static void
+build_traversal_shader(nir_builder *b)
+{
+   nir_def *thread_id = get_thread_id(b);
+
+   nir_deref_instr *traversal_data_in = get_traversal_data(b, thread_id);
+
+   nir_variable *traversal_data_var =
+      nir_local_variable_create(b->impl, traversal_data_in->type,
+                                "traversal_data");
+   nir_deref_instr *traversal_data =
+      nir_build_deref_var(b, traversal_data_var);
+
+   /* Load traversal data.
+    *
+    * TODO: cut down what we load here depending on whether this is an initial
+    * load.
+    */
+   nir_copy_deref(b, traversal_data, traversal_data_in);
+
+   nir_deref_instr *rq = rt_deref(b, traversal_data, rq);
+   nir_def *tlas = rq_load(b, rq, accel_struct_base);
+
+   /* Holds the shader index to jump to */
+   nir_variable *shader_index_var =
+      nir_local_variable_create(b->impl, glsl_uint_type(), "shader_index");
+
+   nir_push_loop(b);
+   {
+      nir_def *incomplete = tu_build_ray_traversal(b, rq, tlas, NULL);
+      nir_push_if(b, incomplete);
+      {
+         /* We didn't finish, which means there was an AABB node or non-opaque
+          * triangle node. Get the intersection or any-hit shader to jump to.
+          * This is the second index in the SBT handle.
+          */
+         nir_def *sbt_addr = get_hit_sbt_addr(b, traversal_data, false);
+         nir_def *shader_record_ptr = nir_iadd_imm(b, sbt_addr,
+                                                   TU_RT_HANDLE_SIZE);
+         nir_def *shader_index =
+            nir_load_global_ir3(b, 1, 32, sbt_addr, nir_imm_int(b, 4),
+                                .align_mul = 4,
+                                .align_offset = 0);
+
+         /* The shader may not be present, check if it's valid and if not
+          * continue our search.
+          */
+         nir_push_if(b, nir_ine_imm(b, shader_index, TU_SHADER_UNUSED));
+         {
+            rt_store(b, traversal_data, shader_record_ptr,
+                     shader_record_ptr, 0x1);
+
+            nir_store_var(b, shader_index_var, shader_index, 0x1);
+            nir_jump(b, nir_jump_break);
+         }
+         nir_pop_if(b, NULL);
+
+         /* The default action depends on whether this is a triangle or AABB
+          * node. If it's a triangle and there's no any-hit shader, the
+          * default action is to accept: "If the any-hit shader identified is
+          * VK_SHADER_UNUSED_KHR, the candidate is immediately confirmed as a
+          * valid hit and passes to the next stage of processing." If it's an
+          * AABB and there's no intersection shader, the default action is to
+          * reject: "If the intersection shader is VK_SHADER_UNUSED_KHR (which
+          * is only allowed for a zero shader group) then no further
+          * processing of the intersection candidate occurs."
+          */
+         nir_push_if(b, nir_inot(b,
+            nir_test_mask(b, rqi_load(b, rq_deref(b, rq, candidate),
+                                      type_flags),
+                          TU_INTERSECTION_TYPE_AABB)));
+         {
+            nir_copy_deref(b, rq_deref(b, rq, closest),
+                           rq_deref(b, rq, candidate));
+         }
+         nir_pop_if(b, NULL);
+      }
+      nir_push_else(b, NULL);
+      {
+         nir_push_if(b, nir_test_mask(b, rqi_load(b, rq_deref(b, rq, closest),
+                                                  type_flags),
+                                      TU_INTERSECTION_TYPE_NO_INTERSECTION));
+         {
+            /* Miss shader case. */
+            nir_def *miss_base =
+               get_sbt_field(b, missShaderBindingTableAddress);
+            nir_def *miss_stride =
+               nir_u2u32(b, get_sbt_field(b, missShaderBindingTableStride));
+            nir_def *miss_index = rt_load(b, traversal_data, miss_index);
+            nir_def *sbt_addr =
+               nir_iadd(b, miss_base,
+                        nir_u2u64(b, nir_imul(b, miss_stride,
+                                              nir_u2u32(b, miss_index))));
+
+            nir_def *shader_index = nir_load_global(b, 1, 32, sbt_addr,
+                                                    .align_mul = 4);
+            nir_def *shader_record_ptr = nir_iadd_imm(b, sbt_addr,
+                                                      TU_RT_HANDLE_SIZE);
+
+            rt_store(b, traversal_data, shader_record_ptr,
+                     shader_record_ptr, 0x1);
+            nir_store_var(b, shader_index_var, shader_index, 0x1);
+         }
+         nir_push_else(b, NULL);
+         {
+            /* Closest-shader case. */
+            nir_def *sbt_addr = get_hit_sbt_addr(b, traversal_data, true);
+
+            /* Get the closest-hit shader */
+            nir_def *shader_index = nir_load_global(b, 1, 32, sbt_addr,
+                                                    .align_mul = 4);
+            nir_def *shader_record_ptr = nir_iadd_imm(b, sbt_addr,
+                                                      TU_RT_HANDLE_SIZE);
+
+            /* Check if SkipClosestHitShaderKHR was specified, and if so make
+             * it unused.
+             */
+            nir_def *skip_closest_hit =
+               nir_test_mask(b, rq_load(b, rq, flags),
+                             TU_RAY_FLAG_SKIP_CLOSEST_HIT_SHADER << 4);
+
+            shader_index = nir_bcsel(b, skip_closest_hit,
+                                     nir_imm_int(b, TU_SHADER_UNUSED),
+                                     shader_index);
+            
+            rt_store(b, traversal_data, shader_record_ptr,
+                     shader_record_ptr, 0x1);
+            nir_store_var(b, shader_index_var, shader_index, 0x1);
+         }
+         nir_pop_if(b, NULL);
+         nir_jump(b, nir_jump_break);
+      }
+      nir_pop_if(b, NULL);
+   }
+   nir_pop_loop(b, NULL);
+
+   /* Store the traversal state.
+    *
+    * TODO: cut down on what we store here depending on whether this is a
+    * closest-hit/miss or any-hit/intersection.
+    */
+   nir_copy_deref(b, traversal_data_in, traversal_data);
+
+   /* Check if the shader is not valid, which can be the case for closest-hit
+    * or miss shaders. In this case we must instead return to the caller,
+    * which would normally be done by the closest-hit or miss shader.
+    */
+   nir_push_if(b, nir_ieq_imm(b, nir_load_var(b, shader_index_var),
+                              TU_SHADER_UNUSED));
+   {
+      nir_store_var(b, shader_index_var, tu_nir_return_index(b), 0x1);
+   }
+   nir_pop_if(b, NULL);
+
+   nir_rt_spawn_thread_ir3(b, nir_load_var(b, shader_index_var));
+}
+
+VkResult
+tu_init_traversal_shader(struct tu_device *dev)
+{
+   nir_builder _b =
+      nir_builder_init_simple_shader(MESA_SHADER_COMPUTE,
+                                     ir3_get_compiler_options(dev->compiler),
+                                     "ray_traversal");
+   nir_builder *b = &_b;
+   b->shader->info.internal = true;
+
+   build_traversal_shader(b);
+
+   NIR_PASS(_, b->shader, nir_lower_continue_constructs);
+
+   /* For convenience we use intrinsics to get the return address and jump to
+    * the next shader, lower these.
+    */
+   NIR_PASS(_, b->shader, tu_nir_lower_rt_intrinsics, 0, 0);
+
+   /* Lower copies we created. */
+   NIR_PASS(_, b->shader, nir_split_var_copies);
+   NIR_PASS(_, b->shader, nir_lower_var_copies);
+
+   struct tu_shader_key tu_key = {
+      .is_rt = true,
+      .api_wavesize = IR3_SINGLE_ONLY,
+      .real_wavesize = IR3_SINGLE_ONLY,
+   }; 
+
+   struct tu_shader_info info = {};
+
+   struct ir3_shader_key ir3_key = {};
+
+   tu_lower_nir(dev, b->shader, &tu_key, &ir3_key, &info);
+
+   const char *key = "tu-traversal-shader";
+   size_t key_size = strlen(key);
+
+   struct tu_pipeline_layout layout = {};
+   
+   /* tu_shader_create takes ownership of the NIR. */
+   return tu_shader_create(dev, &dev->traversal_shader, b->shader,
+                           &tu_key, &info, &ir3_key, key, key_size,
+                           &layout, false);
+}
+
+VkResult
+tu_init_rt_scratch(struct tu_device *dev)
+{
+   unsigned stride;
+   get_rt_traversal_type(&stride);
+
+   uint32_t rt_scratch0_per_thread = TU_HOTZONE_DWORDS * 4 + stride;
+   uint32_t rt_scratch0_size =
+      align(dev->physical_device->info->max_rt_threads *
+            rt_scratch0_per_thread, 64);
+   uint32_t rt_global_count_size = 4 * 4;
+   uint64_t rt_scratch_size = 2 * rt_scratch0_size + 2 * rt_global_count_size;
+
+   VkResult result =
+      tu_bo_init_new(dev, &dev->vk.base, &dev->rt_scratch_bo,
+                     rt_scratch_size, TU_BO_ALLOC_ALLOW_DUMP,
+                     "rt scratch");
+   if (result != VK_SUCCESS)
+      return result;
+
+   dev->rt_scratch0_iova = dev->rt_scratch_bo->iova;
+   dev->rt_scratch0_size = rt_scratch0_per_thread;
+   dev->rt_global_counts0_iova =
+      dev->rt_scratch_bo->iova + 2 * rt_scratch0_size;
+   dev->rt_global_counts1_iova =
+      dev->rt_global_counts0_iova + rt_global_count_size;
+
+   return VK_SUCCESS;
+}
+
