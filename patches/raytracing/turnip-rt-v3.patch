diff --git a/src/freedreno/vulkan/tu_pipeline_rt.cc b/src/freedreno/vulkan/tu_pipeline_rt.cc
new file mode 100644
index 00000000..33d8804f
--- /dev/null
+++ b/src/freedreno/vulkan/tu_pipeline_rt.cc
@@ -0,0 +1,1297 @@
+/*
+ * Copyright © 2024 Valve Corporation
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "vk_pipeline.h"
+
+#include "tu_device.h"
+#include "tu_nir_rt.h"
+#include "tu_pipeline.h"
+#include "tu_rmv.h"
+
+#include "ir3/ir3_nir.h"
+
+static bool
+tu_rt_shader_serialize(struct vk_pipeline_cache_object *object,
+                       struct blob *blob);
+
+static struct vk_pipeline_cache_object *
+tu_rt_shader_deserialize(struct vk_pipeline_cache *cache,
+                         const void *key_data,
+                         size_t key_size,
+                         struct blob_reader *blob);
+
+static void
+tu_rt_shader_destroy(struct vk_device *vk_device,
+                     struct vk_pipeline_cache_object *object)
+{
+   struct tu_device *device = container_of(vk_device, struct tu_device, vk);
+   struct tu_rt_shader *shader =
+      container_of(object, struct tu_rt_shader, base);
+
+   for (unsigned i = 0; i < shader->shader_count; i++) {
+      if (shader->shaders[i])
+         tu_shader_destroy(device, shader->shaders[i]);
+   }
+   
+   vk_pipeline_cache_object_finish(&shader->base);
+}
+
+const struct vk_pipeline_cache_object_ops tu_rt_shader_ops = {
+   .serialize = tu_rt_shader_serialize,
+   .deserialize = tu_rt_shader_deserialize,
+   .destroy = tu_rt_shader_destroy,
+};
+
+static struct tu_rt_shader *
+tu_rt_shader_init(struct tu_device *dev, unsigned subshader_count,
+                  const void *key_data, size_t key_size)
+{
+   VK_MULTIALLOC(ma);
+   VK_MULTIALLOC_DECL(&ma, struct tu_rt_shader, shader, 1);
+   VK_MULTIALLOC_DECL(&ma, struct tu_shader *, subshaders, subshader_count);
+   VK_MULTIALLOC_DECL_SIZE(&ma, char, obj_key_data, key_size);
+
+   if (!vk_multialloc_zalloc(&ma, &dev->vk.alloc,
+                             VK_SYSTEM_ALLOCATION_SCOPE_DEVICE))
+      return NULL;
+
+   shader->shaders = subshaders;
+   shader->shader_count = subshader_count;
+
+   memcpy(obj_key_data, key_data, key_size);
+
+   vk_pipeline_cache_object_init(&dev->vk, &shader->base,
+                                 &tu_rt_shader_ops, obj_key_data, key_size);
+
+   return shader;
+}
+
+static bool
+tu_rt_shader_serialize(struct vk_pipeline_cache_object *object,
+                       struct blob *blob)
+{
+   struct tu_rt_shader *shader =
+      container_of(object, struct tu_rt_shader, base);
+
+   blob_write_uint32(blob, shader->shader_count);
+   blob_write_uint32(blob, shader->stage);
+   blob_write_uint32(blob, shader->stack_size);
+
+   for (unsigned i = 0; i < shader->shader_count; i++)
+      tu_shader_serialize(shader->shaders[i], blob);
+
+   return true;
+}
+
+static struct vk_pipeline_cache_object *
+tu_rt_shader_deserialize(struct vk_pipeline_cache *cache,
+                         const void *key_data,
+                         size_t key_size,
+                         struct blob_reader *blob)
+{
+   struct tu_device *dev =
+      container_of(cache->base.device, struct tu_device, vk);
+   unsigned shader_count = blob_read_uint32(blob);
+
+   struct tu_rt_shader *shader =
+      tu_rt_shader_init(dev, shader_count, key_data, key_size);
+
+   if (!shader)
+      return NULL;
+
+   shader->stage = (mesa_shader_stage)blob_read_uint32(blob);
+   shader->stack_size = blob_read_uint32(blob);
+
+   for (unsigned i = 0; i < shader_count; i++) {
+      shader->shaders[i] = tu_shader_deserialize(dev, NULL, 0, blob);
+      if (!shader->shaders[i]) {
+         for (unsigned j = 0; j < i; j++)
+            tu_shader_destroy(dev, shader->shaders[i]);
+         vk_free(&dev->vk.alloc, shader);
+         return NULL;
+      }
+   }
+   
+   return &shader->base;
+}
+
+static struct tu_rt_shader *
+tu_rt_shader_cache_lookup(struct vk_pipeline_cache *cache,
+                         const void *key_data, size_t key_size,
+                         bool *application_cache_hit)
+{
+   struct vk_pipeline_cache_object *object =
+      vk_pipeline_cache_lookup_object(cache, key_data, key_size,
+                                      &tu_rt_shader_ops, application_cache_hit);
+   if (object)
+      return container_of(object, struct tu_rt_shader, base);
+   else
+      return NULL;
+}
+
+static struct tu_rt_shader *
+tu_rt_shader_cache_insert(struct vk_pipeline_cache *cache,
+                          struct tu_rt_shader *shader)
+{
+   struct vk_pipeline_cache_object *object =
+      vk_pipeline_cache_add_object(cache, &shader->base);
+   return container_of(object, struct tu_rt_shader, base);
+}
+
+struct tu_rt_pipeline_stage {
+   mesa_shader_stage stage;
+
+   struct {
+      mesa_shader_stage stage;
+      unsigned char sha1[20];
+   } cache_key;
+
+   struct tu_shader_key shader_key;
+
+   nir_shader *nir;
+
+   char *nir_initial_disasm;
+
+   VkPipelineCreationFeedback feedback;
+   uint32_t feedback_idx;
+
+   struct tu_rt_shader *shader;
+   uint32_t shader_offset;
+};
+
+static void
+tu_hash_rt_stage(struct tu_pipeline_layout *layout,
+                 VkPipelineCreateFlags2KHR flags,
+                 const VkPipelineShaderStageCreateInfo *sinfo,
+                 struct tu_rt_pipeline_stage *stage)
+{
+   blake3_hasher ctx;
+
+   _mesa_blake3_init(&ctx);
+
+   if (layout)
+      _mesa_blake3_update(&ctx, layout->blake3, sizeof(layout->blake3));
+
+   unsigned char stage_hash[BLAKE3_KEY_LEN];
+   vk_pipeline_hash_shader_stage(flags, sinfo, NULL, stage_hash);
+   _mesa_blake3_update(&ctx, stage_hash, sizeof(stage_hash));
+
+   _mesa_blake3_update(&ctx, &stage->shader_key, sizeof(stage->shader_key));
+
+   enum ir3_shader_debug ir3_debug_key = ir3_shader_debug_hash_key();
+   _mesa_blake3_update(&ctx, &ir3_debug_key, sizeof(ir3_debug_key));
+   _mesa_blake3_final(&ctx, stage->cache_key.sha1);
+}
+
+static void
+tu_hash_rt_intersection(const struct tu_rt_pipeline_stage *intersection_stage,
+                        const struct tu_rt_pipeline_stage *anyhit_stage,
+                        struct tu_rt_pipeline_stage *stage)
+{
+   struct blake3_hasher ctx;
+
+   _mesa_blake3_init(&ctx);
+   _mesa_blake3_update(&ctx, &intersection_stage->cache_key,
+                       sizeof(intersection_stage->cache_key));
+   if (anyhit_stage) {
+      _mesa_blake3_update(&ctx, &anyhit_stage->cache_key,
+                          sizeof(anyhit_stage->cache_key));
+   }
+   _mesa_blake3_final(&ctx, stage->cache_key.sha1);
+}
+
+static struct tu_rt_pipeline_stage *
+tu_pipeline_init_rt_stages(struct tu_rt_pipeline *pipeline,
+                           struct tu_pipeline_layout *layout,
+                           const VkRayTracingPipelineCreateInfoKHR *info,
+                           VkPipelineCreateFlags2KHR flags,
+                           struct tu_device *dev,
+                           void *tmp_pipeline_ctx)
+{
+   struct tu_rt_pipeline_stage *stages =
+      rzalloc_array(tmp_pipeline_ctx, struct tu_rt_pipeline_stage,
+                    info->stageCount + info->groupCount);
+
+   for (uint32_t i = 0; i < info->stageCount; i++) {
+      const VkPipelineShaderStageCreateInfo *sinfo = &info->pStages[i];
+      if (vk_pipeline_shader_stage_is_null(sinfo))
+         continue;
+
+      int64_t stage_start = os_time_get_nano();
+
+      stages[i] = (struct tu_rt_pipeline_stage) {
+         .stage = vk_to_mesa_shader_stage(sinfo->stage),
+         .cache_key = {
+            .stage = vk_to_mesa_shader_stage(sinfo->stage),
+         },
+         .shader_key = {
+            .is_rt = true,
+            .skip_triangles = flags &
+               VK_PIPELINE_CREATE_2_RAY_TRACING_SKIP_TRIANGLES_BIT_KHR,
+            .skip_aabbs = flags &
+               VK_PIPELINE_CREATE_2_RAY_TRACING_SKIP_AABBS_BIT_KHR,
+         },
+         .feedback = {
+            .flags = VK_PIPELINE_CREATION_FEEDBACK_VALID_BIT,
+         },
+      };
+
+      bool allow_varying_subgroup_size =
+         (sinfo->flags &
+          VK_PIPELINE_SHADER_STAGE_CREATE_ALLOW_VARYING_SUBGROUP_SIZE_BIT_EXT);
+      const VkPipelineShaderStageRequiredSubgroupSizeCreateInfo *subgroup_info =
+         vk_find_struct_const(sinfo,
+                              PIPELINE_SHADER_STAGE_REQUIRED_SUBGROUP_SIZE_CREATE_INFO);
+      tu_shader_key_subgroup_size(&stages[i].shader_key,
+                                  allow_varying_subgroup_size,
+                                  false, subgroup_info, dev);
+
+      struct vk_pipeline_robustness_state rs;
+      vk_pipeline_robustness_state_fill(&dev->vk.robustness_state, &rs,
+                                        info->pNext,
+                                        sinfo->pNext);
+      tu_shader_key_robustness(&stages[i].shader_key, &rs);
+
+      pipeline->base.active_stages |= sinfo->stage;
+
+      tu_hash_rt_stage(layout, flags, sinfo, &stages[i]);
+
+      stages[i].feedback.duration += os_time_get_nano() - stage_start;
+   }
+
+   /* Create extra stages for the combined intersection+anyhit shaders */
+   for (uint32_t i = 0; i < info->groupCount; i++) {
+      const VkRayTracingShaderGroupCreateInfoKHR *ginfo = &info->pGroups[i];
+      struct tu_rt_pipeline_stage *stage = &stages[i + info->stageCount];
+
+      if (ginfo->intersectionShader == VK_SHADER_UNUSED_KHR)
+         continue;
+
+      struct tu_rt_pipeline_stage *intersection_stage =
+         &stages[ginfo->intersectionShader];
+      struct tu_rt_pipeline_stage *anyhit_stage =
+         ginfo->anyHitShader == VK_SHADER_UNUSED_KHR ? NULL :
+         &stages[ginfo->anyHitShader];
+
+      *stage = *intersection_stage;
+      tu_hash_rt_intersection(intersection_stage, anyhit_stage, stage);
+   }
+
+   return stages;
+}
+
+static bool
+should_remat_cb(nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+
+   return nir_instr_as_intrinsic(instr)->intrinsic == nir_intrinsic_bindless_resource_ir3;
+}
+
+static VkResult
+tu_compile_rt_shader(struct tu_device *device,
+                     nir_shader *nir,
+                     struct tu_pipeline_layout *layout,
+                     const struct tu_shader_key *key,
+                     const void *key_data, size_t key_size,
+                     bool executable_info,
+                     struct tu_rt_shader **shader_out,
+                     void *mem_ctx)
+{
+   uint32_t pipeline_flags = 0;
+   if (key->skip_triangles)
+      pipeline_flags |= SpvRayFlagsSkipTrianglesKHRMask;
+   if (key->skip_aabbs)
+      pipeline_flags |= SpvRayFlagsSkipAABBsKHRMask;
+
+   /* Save the original stage before lowering to compute shader */
+   mesa_shader_stage stage = nir->info.stage;
+
+   struct ir3_shader_key ir3_key = {};
+   struct tu_shader_info info = {};
+
+   nir_shader **resume_shaders = NULL;
+   uint32_t num_resume_shaders = 0;
+   if (nir->info.stage != MESA_SHADER_COMPUTE) {
+      const nir_lower_shader_calls_options opts = {
+         .address_format = nir_address_format_64bit_global,
+         .stack_alignment = 4,
+         .localized_loads = true,
+         .vectorizer_callback = ir3_nir_should_vectorize_mem,
+         .vectorizer_data = NULL,
+         .should_remat_callback = should_remat_cb,
+      };
+
+      NIR_PASS(_, nir, nir_lower_shader_calls, &opts,
+               &resume_shaders, &num_resume_shaders, mem_ctx);
+      NIR_PASS(_, nir, tu_nir_lower_shader_calls, 0);
+      NIR_PASS(_, nir, tu_nir_lower_rt_intrinsics, 0, pipeline_flags);
+
+      /* Lower copies we created. */
+      NIR_PASS(_, nir, nir_split_var_copies);
+      NIR_PASS(_, nir, nir_lower_var_copies);
+   }
+
+   tu_lower_nir(device, nir, key, &ir3_key, &info);
+
+   for (unsigned i = 0; i < num_resume_shaders; i++) {
+      NIR_PASS(_, resume_shaders[i], tu_nir_lower_shader_calls, i + 1);
+      NIR_PASS(_, resume_shaders[i], tu_nir_lower_rt_intrinsics, i + 1,
+               pipeline_flags);
+      NIR_PASS(_, resume_shaders[i], nir_split_var_copies);
+      NIR_PASS(_, resume_shaders[i], nir_lower_var_copies);
+      tu_lower_nir(device, resume_shaders[i], key, &ir3_key, &info);
+   }
+
+   struct tu_rt_shader *shader =
+      tu_rt_shader_init(device, 1 + num_resume_shaders, key_data, key_size);
+
+   if (!shader)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   shader->stack_size = nir->scratch_size;
+   for (unsigned i = 0; i < num_resume_shaders; i++) {
+      shader->stack_size = MAX2(shader->stack_size,
+                                resume_shaders[i]->scratch_size);
+   }
+
+   shader->stage = stage;
+
+   VkResult result =
+      tu_shader_create(device, &shader->shaders[0], nir, key, &info, &ir3_key,
+                       NULL, 0, layout, executable_info);
+
+   if (result != VK_SUCCESS) {
+      tu_rt_shader_destroy(&device->vk, &shader->base);
+      return result;
+   }
+
+   for (unsigned i = 0; i < num_resume_shaders; i++) {
+      VkResult result =
+         tu_shader_create(device, &shader->shaders[i + 1], resume_shaders[i],
+                          key, &info, &ir3_key, NULL, 0, layout, executable_info);
+
+      if (result != VK_SUCCESS) {
+         tu_rt_shader_destroy(&device->vk, &shader->base);
+         return result;
+      }
+   }
+
+   *shader_out = shader;
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu_compile_rt_shaders(struct tu_rt_pipeline *pipeline,
+                      struct tu_pipeline_layout *layout,
+                      struct tu_device *dev,
+                      VkPipelineCreateFlags2KHR create_flags,
+                      void *pipeline_tmp_ctx,
+                      struct tu_rt_pipeline_stage *stages,
+                      struct vk_pipeline_cache *cache,
+                      const VkRayTracingPipelineCreateInfoKHR *create_info)
+{
+   VkResult result = VK_SUCCESS;
+   const bool executable_info =
+      create_flags &
+      VK_PIPELINE_CREATE_2_CAPTURE_INTERNAL_REPRESENTATIONS_BIT_KHR;
+
+
+   for (unsigned i = 0; i < create_info->stageCount; i++) {
+      struct tu_rt_pipeline_stage *stage = &stages[i];
+
+      /* We always need the NIR for any-hit and intersection shaders so that
+       * we can inline the any-hit shader later.
+       */
+      if (stage->shader && stage->stage != MESA_SHADER_INTERSECTION &&
+          stage->stage != MESA_SHADER_ANY_HIT)
+         continue;
+
+      unsigned char nir_sha1[22];
+      memcpy(nir_sha1, stage->cache_key.sha1, sizeof(stage->cache_key.sha1));
+      nir_sha1[20] = 'N';
+      nir_sha1[21] = stage->stage;
+
+      bool cache_hit;
+
+      int64_t stage_start = os_time_get_nano();
+
+      nir_shader *nir =
+         vk_pipeline_cache_lookup_nir(cache, nir_sha1,
+                                      sizeof(nir_sha1),
+                                      ir3_get_compiler_options(dev->compiler),
+                                      &cache_hit, pipeline_tmp_ctx);
+
+      if (!nir) {
+         nir = tu_spirv_to_nir(dev, pipeline_tmp_ctx, create_flags,
+                               &create_info->pStages[i], &stage->shader_key,
+                               stage->stage);
+         vk_pipeline_cache_add_nir(cache, nir_sha1, sizeof(nir_sha1), nir);
+      }
+
+      if (executable_info) {
+         stage->nir_initial_disasm =
+            nir_shader_as_str(nir, pipeline->base.executables_mem_ctx);
+      }
+
+      stage->feedback.flags = VK_PIPELINE_CREATION_FEEDBACK_VALID_BIT;
+      stage->feedback.duration += os_time_get_nano() - stage_start;
+
+      stage->nir = nir;
+   }
+
+   for (unsigned i = 0; i < create_info->stageCount; i++) {
+      struct tu_rt_pipeline_stage *stage = &stages[i];
+
+      /* We compile intersection shaders later */
+      if (stage->stage == MESA_SHADER_INTERSECTION)
+         continue;
+
+      /* Skip if we've gotten the shader from the cache */
+      if (stage->shader)
+         continue;
+
+      int64_t stage_start = os_time_get_nano();
+
+      /* For any-hit shaders, we need to preserve the original shader in case
+       * it gets inlined into an intersection shader. For other shaders we can
+       * transfer ownership to the the tu_rt_shader.
+       */
+      nir_shader *nir;
+      if (stages[i].stage == MESA_SHADER_ANY_HIT) {
+         nir = nir_shader_clone(NULL, stage->nir);
+      } else {
+         nir = stage->nir;
+         stage->nir = NULL;
+      }
+
+      switch (stages[i].stage) {
+      case MESA_SHADER_RAYGEN:
+         tu_nir_lower_raygen(nir);
+         break;
+
+      case MESA_SHADER_ANY_HIT:
+         tu_nir_lower_any_hit(nir);
+         break;
+
+      case MESA_SHADER_CLOSEST_HIT:
+         tu_nir_lower_closest_hit(nir);
+         break;
+
+      case MESA_SHADER_MISS:
+         tu_nir_lower_miss(nir);
+         break;
+
+      case MESA_SHADER_INTERSECTION:
+         UNREACHABLE("These are handled later");
+
+      case MESA_SHADER_CALLABLE:
+         tu_nir_lower_callable(nir);
+         break;
+
+      default:
+         UNREACHABLE("Invalid ray-tracing shader stage");
+      }
+
+      result = tu_compile_rt_shader(dev, nir, layout,
+                                    &stage->shader_key, &stage->cache_key,
+                                    sizeof(stage->cache_key), executable_info,
+                                    &stage->shader,
+                                    pipeline_tmp_ctx);
+
+      stage->feedback.duration += os_time_get_nano() - stage_start;
+
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   /* Compile combined intersection+anyhit shaders */
+   for (unsigned i = 0; i < create_info->groupCount; i++) {
+      const VkRayTracingShaderGroupCreateInfoKHR *ginfo =
+         &create_info->pGroups[i];
+
+      if (ginfo->intersectionShader == VK_SHADER_UNUSED_KHR)
+         continue;
+
+      struct tu_rt_pipeline_stage *stage =
+         &stages[i + create_info->stageCount];
+      struct tu_rt_pipeline_stage *intersection_stage =
+         &stages[ginfo->intersectionShader];
+      struct tu_rt_pipeline_stage *anyhit_stage =
+         ginfo->anyHitShader == VK_SHADER_UNUSED_KHR ? NULL :
+         &stages[ginfo->anyHitShader];
+
+      if (stage->shader)
+         continue;
+
+      int64_t stage_start = os_time_get_nano();
+
+      stage->nir_initial_disasm = intersection_stage->nir_initial_disasm;
+
+      /* Inline the anyhit shader into the intersection shader */
+      nir_shader *nir =
+         nir_shader_clone(pipeline_tmp_ctx, intersection_stage->nir);
+      tu_nir_lower_combined_intersection_any_hit(nir, anyhit_stage ?
+                                                 anyhit_stage->nir : NULL);
+
+      result = tu_compile_rt_shader(dev, nir, layout,
+                                    &stage->shader_key, &stage->cache_key,
+                                    sizeof(stage->cache_key), executable_info,
+                                    &stage->shader,
+                                    pipeline_tmp_ctx);
+
+      intersection_stage->feedback.duration += os_time_get_nano() - stage_start;
+
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   /* Cleanup the intermediate NIR for intersection/anyhit shaders */
+   for (unsigned i = 0; i < create_info->stageCount; i++) {
+      struct tu_rt_pipeline_stage *stage = &stages[i];
+
+      if (stage->nir)
+         ralloc_free(stage->nir);
+   }
+
+   return VK_SUCCESS;
+}
+
+static void
+tu_append_rt_executables(struct tu_pipeline *pipeline,
+                         struct tu_rt_pipeline_stage *stage)
+{
+   for (unsigned i = 0; i < stage->shader->shader_count; i++) {
+      struct tu_shader *shader = stage->shader->shaders[i];
+      struct tu_pipeline_executable exe = {
+         .stage = stage->stage,
+         .stats = shader->variant->info,
+         .part_no = i,
+         .total_parts = stage->shader->shader_count,
+         .nir_from_spirv = stage->nir_initial_disasm,
+         .nir_final = ralloc_strdup(pipeline->executables_mem_ctx,
+                                    shader->variant->disasm_info.nir),
+         .disasm = ralloc_strdup(pipeline->executables_mem_ctx,
+                                 shader->variant->disasm_info.disasm),
+      };
+
+      util_dynarray_append(&pipeline->executables, exe);
+   }
+}
+
+static VkResult
+tu_pipeline_compile_rt(struct tu_rt_pipeline *pipeline,
+                       struct tu_pipeline_layout *layout,
+                       struct tu_device *dev,
+                       VkPipelineCreateFlags2KHR create_flags,
+                       void *pipeline_tmp_ctx,
+                       struct tu_rt_pipeline_stage *stages,
+                       struct vk_pipeline_cache *cache,
+                       const VkRayTracingPipelineCreateInfoKHR *create_info)
+{
+   VkPipelineCreationFeedback pipeline_feedback = {
+      .flags = VK_PIPELINE_CREATION_FEEDBACK_VALID_BIT,
+   };
+   int64_t pipeline_start = os_time_get_nano();
+
+   const bool executable_info =
+      create_flags &
+      VK_PIPELINE_CREATE_2_CAPTURE_INTERNAL_REPRESENTATIONS_BIT_KHR;
+
+   bool cache_hit = false;
+
+   if (!executable_info) {
+      cache_hit = true;
+      bool application_cache_hit = false;
+
+      for (unsigned i = 0; i < create_info->stageCount; i++) {
+         struct tu_rt_pipeline_stage *stage = &stages[i];
+         bool shader_application_cache_hit;
+
+         /* Skip intersection shaders because they are compiled with the
+          * group.
+          */
+         if (stage->stage == MESA_SHADER_INTERSECTION)
+            continue;
+
+         stage->shader =
+            tu_rt_shader_cache_lookup(cache, &stage->cache_key,
+                                      sizeof(stage->cache_key),
+                                      &shader_application_cache_hit);
+         if (!stage->shader) {
+            cache_hit = false;
+         }
+         application_cache_hit &= shader_application_cache_hit;
+      }
+
+      for (unsigned i = 0; i < create_info->groupCount; i++) {
+         if (create_info->pGroups[i].intersectionShader ==
+             VK_SHADER_UNUSED_KHR)
+            continue;
+
+         bool shader_application_cache_hit;
+         struct tu_rt_pipeline_stage *stage =
+            &stages[i + create_info->stageCount];
+
+         stage->shader =
+            tu_rt_shader_cache_lookup(cache, &stage->cache_key,
+                                      sizeof(stage->cache_key),
+                                      &shader_application_cache_hit);
+         if (!stage->shader) {
+            cache_hit = false;
+         }
+         application_cache_hit &= shader_application_cache_hit;
+      }
+
+      if (application_cache_hit) {
+         pipeline_feedback.flags |=
+            VK_PIPELINE_CREATION_FEEDBACK_APPLICATION_PIPELINE_CACHE_HIT_BIT;
+      }
+   }
+
+   if (!cache_hit) {
+      if (create_flags &
+          VK_PIPELINE_CREATE_2_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT_KHR) {
+         return VK_PIPELINE_COMPILE_REQUIRED;
+      }
+
+      VkResult result =
+         tu_compile_rt_shaders(pipeline, layout, dev, create_flags,
+                               pipeline_tmp_ctx, stages, cache, create_info);
+      if (result != VK_SUCCESS)
+         return result;
+
+      for (unsigned i = 0; i < create_info->stageCount; i++) {
+         struct tu_rt_pipeline_stage *stage = &stages[i];
+
+         if (stage->stage == MESA_SHADER_INTERSECTION)
+            continue;
+
+         stage->shader = tu_rt_shader_cache_insert(cache, stage->shader);
+
+         if (executable_info)
+            tu_append_rt_executables(&pipeline->base, stage);
+      }
+
+      for (unsigned i = 0; i < create_info->groupCount; i++) {
+         if (create_info->pGroups[i].intersectionShader ==
+             VK_SHADER_UNUSED_KHR)
+            continue;
+
+         struct tu_rt_pipeline_stage *stage =
+            &stages[i + create_info->stageCount];
+
+         stage->shader = tu_rt_shader_cache_insert(cache, stage->shader);
+
+         if (executable_info)
+            tu_append_rt_executables(&pipeline->base, stage);
+      }
+   }
+
+   unsigned shader_offset = 1; /* The traversal shader is always first */
+
+   for (unsigned i = 0; i < create_info->stageCount; i++) {
+      struct tu_rt_pipeline_stage *stage = &stages[i];
+
+      if (stage->stage == MESA_SHADER_INTERSECTION)
+         continue;
+
+      stage->shader_offset = shader_offset;
+      shader_offset += stage->shader->shader_count;
+
+      pipeline->shaders[pipeline->shader_count++] = stage->shader;
+   }
+
+   for (unsigned i = 0; i < create_info->groupCount; i++) {
+      if (create_info->pGroups[i].intersectionShader ==
+          VK_SHADER_UNUSED_KHR)
+         continue;
+
+      struct tu_rt_pipeline_stage *stage =
+         &stages[i + create_info->stageCount];
+
+      stage->shader_offset = shader_offset;
+      shader_offset += stage->shader->shader_count;
+
+      pipeline->shaders[pipeline->shader_count++] = stage->shader;
+
+      if (executable_info)
+         tu_append_rt_executables(&pipeline->base, stage);
+   }
+
+   pipeline->total_subshaders = shader_offset - 1; /* remove traversal shader */
+
+   pipeline_feedback.duration = os_time_get_nano() - pipeline_start;
+
+   const VkPipelineCreationFeedbackCreateInfo *create_feedback =
+      vk_find_struct_const(create_info->pNext, PIPELINE_CREATION_FEEDBACK_CREATE_INFO);
+   if (create_feedback) {
+      *create_feedback->pPipelineCreationFeedback = pipeline_feedback;
+
+      uint32_t stage_count = create_feedback->pipelineStageCreationFeedbackCount;
+      assert(stage_count == 0 || create_info->stageCount == stage_count);
+      for (uint32_t i = 0; i < stage_count; i++) {
+         create_feedback->pPipelineStageCreationFeedbacks[i] = stages[i].feedback;
+      }
+   }
+
+   return VK_SUCCESS;
+}
+
+static bool
+is_rt_stack_size_dynamic(const VkRayTracingPipelineCreateInfoKHR *info)
+{
+   if (info->pDynamicState == NULL)
+      return false;
+
+   for (unsigned i = 0; i < info->pDynamicState->dynamicStateCount; i++) {
+      if (info->pDynamicState->pDynamicStates[i] ==
+          VK_DYNAMIC_STATE_RAY_TRACING_PIPELINE_STACK_SIZE_KHR)
+         return true;
+   }
+
+   return false;
+}
+
+static void
+tu_pipeline_compute_rt_stacks(struct tu_rt_pipeline *pipeline,
+                              const VkRayTracingPipelineCreateInfoKHR *info,
+                              uint32_t *stack_max)
+{
+   if (is_rt_stack_size_dynamic(info)) {
+      pipeline->stack_size = 0; /* 0 means dynamic */
+   } else {
+      /* From the Vulkan spec:
+       *
+       *    "If the stack size is not set explicitly, the stack size for a
+       *    pipeline is:
+       *
+       *       rayGenStackMax +
+       *       min(1, maxPipelineRayRecursionDepth) ×
+       *       max(closestHitStackMax, missStackMax,
+       *           intersectionStackMax + anyHitStackMax) +
+       *       max(0, maxPipelineRayRecursionDepth-1) ×
+       *       max(closestHitStackMax, missStackMax) +
+       *       2 × callableStackMax"
+       */
+      pipeline->stack_size =
+         stack_max[MESA_SHADER_RAYGEN] +
+         MIN2(1, info->maxPipelineRayRecursionDepth) *
+         MAX4(stack_max[MESA_SHADER_CLOSEST_HIT],
+              stack_max[MESA_SHADER_MISS],
+              stack_max[MESA_SHADER_INTERSECTION],
+              stack_max[MESA_SHADER_ANY_HIT]) +
+         MAX2(0, (int)info->maxPipelineRayRecursionDepth - 1) *
+         MAX2(stack_max[MESA_SHADER_CLOSEST_HIT],
+              stack_max[MESA_SHADER_MISS]) +
+         2 * stack_max[MESA_SHADER_CALLABLE];
+
+      /* This is an extremely unlikely case but we need to set it to some
+       * non-zero value so that we don't accidentally think it's dynamic.
+       * We could set to any small value we like.
+       */
+      if (pipeline->stack_size == 0)
+         pipeline->stack_size = 1;
+   }
+}
+
+static void
+tu_create_group_handles(struct tu_device *device,
+                        const VkRayTracingPipelineCreateInfoKHR *create_info,
+                        const struct tu_rt_pipeline_stage *stages,
+                        struct tu_rt_shader_group *groups)
+{
+   for (unsigned i = 0; i < create_info->groupCount; i++) {
+      const VkRayTracingShaderGroupCreateInfoKHR *group_info = &create_info->pGroups[i];
+      groups[i].type = group_info->type;
+      switch (group_info->type) {
+      case VK_RAY_TRACING_SHADER_GROUP_TYPE_GENERAL_KHR:
+         if (group_info->generalShader != VK_SHADER_UNUSED_KHR) {
+            const struct tu_rt_pipeline_stage *stage =
+               &stages[group_info->generalShader];
+            groups[i].handle.general_index = stage->shader_offset;
+            groups[i].general = stage->shader;
+         } else {
+            groups[i].handle.general_index = TU_SHADER_UNUSED;
+         }
+         break;
+      case VK_RAY_TRACING_SHADER_GROUP_TYPE_PROCEDURAL_HIT_GROUP_KHR:
+         if (group_info->closestHitShader != VK_SHADER_UNUSED_KHR) {
+            const struct tu_rt_pipeline_stage *stage =
+               &stages[group_info->closestHitShader];
+            groups[i].handle.closest_hit_index = stage->shader_offset;
+            groups[i].closest_hit = stage->shader;
+         } else {
+            groups[i].handle.closest_hit_index = TU_SHADER_UNUSED;
+         }
+
+         if (group_info->intersectionShader != VK_SHADER_UNUSED_KHR) {
+            const struct tu_rt_pipeline_stage *stage =
+               &stages[i + create_info->stageCount];
+            groups[i].handle.intersection_index = stage->shader_offset;
+            groups[i].intersection = stage->shader;
+         } else {
+            groups[i].handle.intersection_index = TU_SHADER_UNUSED;
+         }
+         break;
+      case VK_RAY_TRACING_SHADER_GROUP_TYPE_TRIANGLES_HIT_GROUP_KHR:
+         if (group_info->closestHitShader != VK_SHADER_UNUSED_KHR) {
+            const struct tu_rt_pipeline_stage *stage =
+               &stages[group_info->closestHitShader];
+            groups[i].handle.closest_hit_index = stage->shader_offset;
+            groups[i].closest_hit = stage->shader;
+         } else {
+            groups[i].handle.closest_hit_index = TU_SHADER_UNUSED;
+         }
+
+         if (group_info->anyHitShader != VK_SHADER_UNUSED_KHR) {
+            const struct tu_rt_pipeline_stage *stage =
+               &stages[group_info->anyHitShader];
+            groups[i].handle.any_hit_index = stage->shader_offset;
+            groups[i].any_hit = stage->shader;
+         } else {
+            groups[i].handle.any_hit_index = TU_SHADER_UNUSED;
+         }
+         break;
+      }
+   }
+}
+
+static void
+tu_import_group_handles(struct tu_rt_pipeline *pipeline,
+                        uint32_t subshader_offset,
+                        uint32_t group_offset,
+                        struct tu_rt_pipeline *library)
+{
+   for (unsigned i = 0; i < library->group_count; i++) {
+      const struct tu_rt_shader_group *library_group = &library->groups[i];
+      struct tu_rt_shader_group *group = &pipeline->groups[group_offset + i];
+      group->type = library_group->type;
+      switch (group->type) {
+      case VK_RAY_TRACING_SHADER_GROUP_TYPE_GENERAL_KHR:
+         if (library_group->general) {
+            group->handle.general_index =
+               library_group->handle.general_index + subshader_offset;
+            group->general = library_group->general;
+         } else {
+            group->handle.general_index = TU_SHADER_UNUSED;
+         }
+         break;
+      case VK_RAY_TRACING_SHADER_GROUP_TYPE_PROCEDURAL_HIT_GROUP_KHR:
+         if (library_group->closest_hit) {
+            group->handle.closest_hit_index =
+               library_group->handle.closest_hit_index + subshader_offset;
+            group->closest_hit = library_group->closest_hit;
+         } else {
+            group->handle.closest_hit_index = TU_SHADER_UNUSED;
+         }
+
+         if (library_group->intersection) {
+            group->handle.intersection_index =
+               library_group->handle.intersection_index + subshader_offset;
+            group->intersection = library_group->intersection;
+         } else {
+            group->handle.intersection_index = TU_SHADER_UNUSED;
+         }
+         break;
+      case VK_RAY_TRACING_SHADER_GROUP_TYPE_TRIANGLES_HIT_GROUP_KHR:
+         if (library_group->closest_hit) {
+            group->handle.closest_hit_index =
+               library_group->handle.closest_hit_index + subshader_offset;
+            group->closest_hit = library_group->closest_hit;
+         } else {
+            group->handle.closest_hit_index = TU_SHADER_UNUSED;
+         }
+
+         if (library_group->any_hit) {
+            group->handle.any_hit_index =
+               library_group->handle.any_hit_index + subshader_offset;
+            group->any_hit = library_group->any_hit;
+         } else {
+            group->handle.any_hit_index = TU_SHADER_UNUSED;
+         }
+         break;
+      }
+   }
+}
+
+static void
+tu_merge_const_state(struct tu_const_state *const_state,
+                     const struct tu_const_state *shader_const_state)
+{
+   /* There shouldn't be any partial pipeline layouts */
+   assert(shader_const_state->dynamic_offsets_ubo.idx == -1);
+
+   if (shader_const_state->num_inline_ubos &&
+       !const_state->num_inline_ubos) {
+      /* The inline uniform UBO is only based on the pipeline layout, and we
+       * hardcoded its location, so it should be identical betweeen shaders.
+       */
+      assert(const_state->inline_uniforms_ubo.idx ==
+             shader_const_state->inline_uniforms_ubo.idx &&
+             const_state->inline_uniforms_ubo.size ==
+             shader_const_state->inline_uniforms_ubo.size);
+      const_state->inline_uniforms_ubo =
+         shader_const_state->inline_uniforms_ubo;
+      const_state->num_inline_ubos = shader_const_state->num_inline_ubos;
+      memcpy(const_state->ubos, shader_const_state->ubos,
+             sizeof(const_state->ubos));
+   }
+
+   if (shader_const_state->push_consts.dwords != 0) {
+      uint32_t hi_dwords = const_state->push_consts.lo_dwords +
+         const_state->push_consts.dwords;
+      const_state->push_consts.lo_dwords =
+         MIN2(const_state->push_consts.lo_dwords,
+              shader_const_state->push_consts.lo_dwords);
+      const_state->push_consts.dwords =
+         MAX2(hi_dwords,
+              shader_const_state->push_consts.lo_dwords +
+              shader_const_state->push_consts.dwords) -
+         const_state->push_consts.lo_dwords;
+      const_state->push_consts.type = shader_const_state->push_consts.type;
+   }
+}
+
+static void
+tu_rt_init_const_state(struct tu_rt_pipeline *pipeline)
+{
+   pipeline->const_state.push_consts = (struct tu_push_constant_range) {};
+   pipeline->const_state.num_inline_ubos = 0;
+   pipeline->const_state.inline_uniforms_ubo.idx = -1;
+   pipeline->const_state.inline_uniforms_ubo.size = 0;
+
+   for (uint32_t i = 0; i < pipeline->shader_count; i++) {
+      struct tu_rt_shader *shader = pipeline->shaders[i];
+      for (uint32_t j = 0; j < shader->shader_count; j++) {
+         struct tu_shader *subshader = shader->shaders[j];
+
+         tu_merge_const_state(&pipeline->const_state,
+                              &subshader->const_state);
+      }
+   }
+}
+
+enum tu_rt_scratch_buffer {
+   RT_SHADER_TO_SLOT,
+   RT_SLOT_TO_SHADER,
+   RT_COUNTS,
+   RT_PENDING_THREAD_IDS,
+   RT_SCRATCH_BUFFER_COUNT
+};
+
+static VkResult
+tu_upload_rt_pipeline(struct tu_device *dev, struct tu_rt_pipeline *pipeline)
+{
+   uint32_t subshader_count = pipeline->total_subshaders + 1; /* include traversal shader */
+   uint32_t size = (8 + 4) * subshader_count;
+
+   mtx_lock(&dev->pipeline_mutex);
+   VkResult result = tu_suballoc_bo_alloc(&pipeline->base.bo,
+                                          &dev->pipeline_suballoc,
+                                          size, 4);
+   mtx_unlock(&dev->pipeline_mutex);
+   if (result != VK_SUCCESS)
+      return result;
+
+   TU_RMV(cmd_buffer_suballoc_bo_create, dev, &pipeline->base.bo);
+
+   void *map = tu_suballoc_bo_map(&pipeline->base.bo);
+
+   uint32_t shader_ibs_offset = 8 * subshader_count;
+   uint64_t *shader_ib_iovas = (uint64_t *)map;
+   uint32_t *shader_ib_sizes =
+      (uint32_t *)((char *)map + shader_ibs_offset);
+   pipeline->shader_ibs_iova = pipeline->base.bo.iova;
+   pipeline->shader_ibs_size_iova = pipeline->base.bo.iova +
+      shader_ibs_offset;
+
+   shader_ib_iovas[0] = dev->traversal_shader->state.iova;
+   shader_ib_sizes[0] = dev->traversal_shader->state.size;
+
+   uint32_t offset = 1;
+
+   for (unsigned i = 0; i < pipeline->shader_count; i++) {
+      struct tu_rt_shader *shader = pipeline->shaders[i];
+
+      for (unsigned i = 0; i < shader->shader_count; i++, offset++) {
+         struct tu_shader *subshader = shader->shaders[i];
+         shader_ib_iovas[offset] = subshader->state.iova;
+         shader_ib_sizes[offset] = subshader->state.size;
+      }
+   }
+
+   uint32_t slot_count = subshader_count + 1;
+
+   uint64_t sizes[RT_SCRATCH_BUFFER_COUNT] = {
+      [RT_SHADER_TO_SLOT] = 4 * subshader_count * 2,
+      [RT_SLOT_TO_SHADER] = 4 * slot_count * 2,
+      [RT_COUNTS] = 4 * slot_count * 2,
+      [RT_PENDING_THREAD_IDS] =
+         align(2 * dev->physical_device->info->max_rt_threads, 4) *
+            slot_count * 2,
+   };
+
+   uint64_t offsets[RT_SCRATCH_BUFFER_COUNT];
+   uint64_t bo_offset = 0;
+   for (unsigned i = 0; i < ARRAY_SIZE(sizes); i++) {
+      offsets[i] = bo_offset;
+      bo_offset += sizes[i];
+   }
+
+   result = tu_bo_init_new(dev, &pipeline->base.base,
+                           &pipeline->scratch_bo, bo_offset,
+                           TU_BO_ALLOC_ALLOW_DUMP,
+                           "rt pipeline scratch");
+   if (result != VK_SUCCESS) {
+      mtx_lock(&dev->pipeline_mutex);
+      tu_suballoc_bo_free(&dev->pipeline_suballoc, &pipeline->base.bo);
+      mtx_unlock(&dev->pipeline_mutex);
+      return result;
+   }
+
+   uint64_t iova = pipeline->scratch_bo->iova;
+   pipeline->shader_to_slot_iova = iova + offsets[RT_SHADER_TO_SLOT];
+   pipeline->slot_to_shader_iova = iova + offsets[RT_SLOT_TO_SHADER];
+   pipeline->counts_iova = iova + offsets[RT_COUNTS];
+   pipeline->pending_thread_ids_iova = iova + offsets[RT_PENDING_THREAD_IDS];
+
+   return VK_SUCCESS;
+}
+
+static VkResult
+tu_rt_pipeline_create(VkDevice device,
+                      VkPipelineCache pipelineCache,
+                      const VkRayTracingPipelineCreateInfoKHR *pCreateInfo,
+                      VkPipelineCreateFlags2KHR flags,
+                      const VkAllocationCallbacks *pAllocator,
+                      VkPipeline *pPipeline)
+{
+   VK_FROM_HANDLE(tu_device, dev, device);
+   VK_FROM_HANDLE(vk_pipeline_cache, cache, pipelineCache);
+   VK_FROM_HANDLE(tu_pipeline_layout, layout, pCreateInfo->layout);
+
+   cache = cache ? cache : dev->mem_cache;
+
+   *pPipeline = VK_NULL_HANDLE;
+
+   uint32_t group_count = pCreateInfo->groupCount;
+   /* add in groupCount in case there are intersection shaders which are
+    * compiled with the group.
+    */
+   uint32_t shader_count = pCreateInfo->groupCount + pCreateInfo->stageCount;
+   if (pCreateInfo->pLibraryInfo) {
+      for (uint32_t l = 0; l < pCreateInfo->pLibraryInfo->libraryCount; l++) {
+         VK_FROM_HANDLE(tu_pipeline, library,
+                        pCreateInfo->pLibraryInfo->pLibraries[l]);
+         struct tu_rt_pipeline *rt_library = tu_pipeline_to_rt(library);
+         group_count += rt_library->group_count;
+         shader_count += rt_library->shader_count;
+      }
+   }
+
+   VK_MULTIALLOC(ma);
+   VK_MULTIALLOC_DECL(&ma, struct tu_rt_pipeline, pipeline, 1);
+   VK_MULTIALLOC_DECL(&ma, struct tu_rt_shader_group, groups, group_count);
+   VK_MULTIALLOC_DECL(&ma, struct tu_rt_shader *, shaders, shader_count);
+   if (!vk_object_multizalloc(&dev->vk, &ma, pAllocator,
+                              VK_OBJECT_TYPE_PIPELINE))
+      return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+
+   pipeline->base.type = TU_PIPELINE_RT;
+
+   pipeline->base.executables_mem_ctx = ralloc_context(NULL);
+   util_dynarray_init(&pipeline->base.executables, pipeline->base.executables_mem_ctx);
+   pipeline->group_count = group_count;
+   pipeline->groups = groups;
+   pipeline->shaders = shaders;
+
+   void *tmp_ctx = ralloc_context(NULL);
+
+   struct tu_rt_pipeline_stage *stages =
+      tu_pipeline_init_rt_stages(pipeline, layout, pCreateInfo, flags, dev,
+                                 tmp_ctx);
+
+   VkResult result =
+      tu_pipeline_compile_rt(pipeline, layout, dev, flags, tmp_ctx, stages,
+                             cache, pCreateInfo);
+   if (result != VK_SUCCESS) {
+      for (uint32_t i = 0; i < pCreateInfo->stageCount; i++) {
+         if (stages[i].shader != NULL)
+            vk_pipeline_cache_object_unref(&dev->vk, &stages[i].shader->base);
+      }
+      ralloc_free(tmp_ctx);
+      vk_free2(&dev->vk.alloc, pAllocator, pipeline);
+      return result;
+   }
+
+   tu_create_group_handles(dev, pCreateInfo, stages, groups);
+
+   ralloc_free(tmp_ctx);
+
+   if (pCreateInfo->pLibraryInfo) {
+      uint32_t subshader_offset = pipeline->total_subshaders;
+      uint32_t group_offset = pCreateInfo->groupCount;
+
+      for (unsigned i = 0; i < pCreateInfo->pLibraryInfo->libraryCount; ++i) {
+         VK_FROM_HANDLE(tu_pipeline, pipeline_lib, pCreateInfo->pLibraryInfo->pLibraries[i]);
+         struct tu_rt_pipeline *library = tu_pipeline_to_rt(pipeline_lib);
+
+         tu_import_group_handles(pipeline, subshader_offset, group_offset,
+                                 library);
+
+         for (unsigned i = 0; i < library->shader_count; i++) {
+            struct tu_rt_shader *shader = library->shaders[i];
+            vk_pipeline_cache_object_ref(&shader->base);
+            pipeline->shaders[pipeline->shader_count++] = shader;
+         }
+
+         subshader_offset += library->total_subshaders;
+         group_offset += library->group_count;
+      }
+
+      pipeline->total_subshaders = subshader_offset;
+   }
+
+   /* Compute the size of the scratch BO (for register spilling) by taking the
+    * max of all the shaders in the pipeline.
+    */
+   uint32_t stack_max[MESA_VULKAN_SHADER_STAGES] = {};
+   for (unsigned i = 0; i < pipeline->shader_count; i++) {
+      struct tu_rt_shader *shader = pipeline->shaders[i];
+      uint32_t stack_size = shader->stack_size;
+      stack_max[shader->stage] = MAX2(stack_max[shader->stage], stack_size);
+   }
+
+   tu_pipeline_compute_rt_stacks(pipeline, pCreateInfo, stack_max);
+
+   /* Finally, if not a library, upload the array of shader IBs */
+   if (!(flags & VK_PIPELINE_CREATE_2_LIBRARY_BIT_KHR)) {
+      VkResult result = tu_upload_rt_pipeline(dev, pipeline);
+      if (result != VK_SUCCESS) {
+         for (unsigned i = 0; i < pipeline->shader_count; i++) {
+            struct tu_rt_shader *shader = pipeline->shaders[i];
+            vk_pipeline_cache_object_unref(&dev->vk, &shader->base);
+         }
+         vk_free2(&dev->vk.alloc, pAllocator, pipeline);
+         return result;
+      }
+      tu_rt_init_const_state(pipeline);
+   }
+
+   *pPipeline = tu_pipeline_to_handle(&pipeline->base);
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_CreateRayTracingPipelinesKHR(VkDevice device,
+                                VkDeferredOperationKHR deferredOperation,
+                                VkPipelineCache pipelineCache,
+                                uint32_t count,
+                                const VkRayTracingPipelineCreateInfoKHR *pCreateInfos,
+                                const VkAllocationCallbacks *pAllocator,
+                                VkPipeline *pPipelines)
+{
+   MESA_TRACE_FUNC();
+   VkResult final_result = VK_SUCCESS;
+   uint32_t i = 0;
+
+   for (; i < count; i++) {
+      VkPipelineCreateFlags2KHR flags =
+         vk_rt_pipeline_create_flags(&pCreateInfos[i]);
+
+      VkResult result =
+         tu_rt_pipeline_create(device, pipelineCache,
+                                     &pCreateInfos[i], flags,
+                                     pAllocator, &pPipelines[i]);
+
+      if (result != VK_SUCCESS) {
+         final_result = result;
+         pPipelines[i] = VK_NULL_HANDLE;
+
+         if (flags & VK_PIPELINE_CREATE_2_EARLY_RETURN_ON_FAILURE_BIT_KHR)
+            break;
+      }
+   }
+
+   for (; i < count; i++)
+      pPipelines[i] = VK_NULL_HANDLE;
+
+   return final_result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
+tu_GetRayTracingShaderGroupHandlesKHR(VkDevice device,
+                                      VkPipeline _pipeline,
+                                      uint32_t firstGroup,
+                                      uint32_t groupCount,
+                                      size_t dataSize, void *pData)
+{
+   VK_FROM_HANDLE(tu_pipeline, pipeline, _pipeline);
+   assert(pipeline->type == TU_PIPELINE_RT);
+
+   struct tu_rt_pipeline *rt_pipeline =
+      tu_pipeline_to_rt(pipeline);
+
+   assert(firstGroup + groupCount <= rt_pipeline->group_count);
+
+   struct tu_rt_shader_group *groups = rt_pipeline->groups;
+   char *data = (char *)pData;
+
+   STATIC_ASSERT(sizeof(struct tu_pipeline_group_handle) <= TU_RT_HANDLE_SIZE);
+
+   memset(data, 0, groupCount * TU_RT_HANDLE_SIZE);
+
+   for (uint32_t i = 0; i < groupCount; ++i) {
+      memcpy(data + i * TU_RT_HANDLE_SIZE, &groups[firstGroup + i].handle,
+             sizeof(struct tu_pipeline_group_handle));
+   }
+
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR VkDeviceSize VKAPI_CALL
+tu_GetRayTracingShaderGroupStackSizeKHR(VkDevice device,
+                                        VkPipeline _pipeline, uint32_t group,
+                                        VkShaderGroupShaderKHR groupShader)
+{
+   VK_FROM_HANDLE(tu_pipeline, pipeline, _pipeline);
+   assert(pipeline->type == TU_PIPELINE_RT);
+
+   struct tu_rt_pipeline *rt_pipeline =
+      tu_pipeline_to_rt(pipeline);
+
+   assert(group < rt_pipeline->group_count);
+
+   struct tu_rt_shader *shader;
+   switch (groupShader) {
+   case VK_SHADER_GROUP_SHADER_GENERAL_KHR:
+      shader = rt_pipeline->groups[group].general;
+      break;
+
+   case VK_SHADER_GROUP_SHADER_CLOSEST_HIT_KHR:
+      shader = rt_pipeline->groups[group].closest_hit;
+      break;
+
+   case VK_SHADER_GROUP_SHADER_ANY_HIT_KHR:
+      shader = rt_pipeline->groups[group].any_hit;
+      break;
+
+   case VK_SHADER_GROUP_SHADER_INTERSECTION_KHR:
+      shader = rt_pipeline->groups[group].intersection;
+      break;
+
+   default:
+      UNREACHABLE("Invalid VkShaderGroupShader enum");
+   }
+
+   if (shader == NULL)
+      return 0;
+
+   return shader->stack_size;
+}
