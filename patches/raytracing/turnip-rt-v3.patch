+template <chip CHIP>
+static void
+tu_emit_rt_params(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   struct tu_rt_pipeline *pipeline = cmd->state.rt_pipeline;
+   struct tu_rt_params params = {
+      .counts_addr = pipeline->counts_iova,
+      .pending_thread_ids_addr = pipeline->pending_thread_ids_iova,
+      .stack_size = cmd->state.rt_stack_size,
+   };
+
+   unsigned num_units = sizeof(params) / 4;
+   struct tu_cs sub_cs;
+   VkResult result =
+      tu_cs_begin_sub_stream_aligned(&cmd->sub_cs, num_units, 4,
+                                     &sub_cs);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   tu_cs_emit_array(&sub_cs, (uint32_t *)&params, num_units);
+
+   struct tu_draw_state params_ubo = tu_cs_end_draw_state(&cmd->sub_cs, &sub_cs);
+
+   tu_cs_emit_regs(cs, SP_UPDATE_CNTL(CHIP,
+         .cs_state = true,
+         .cs_uav = true,));
+
+   tu_cs_emit_pkt7(cs, CP_LOAD_STATE6_FRAG, 5);
+   tu_cs_emit(cs,
+              CP_LOAD_STATE6_0_DST_OFF(TU_RT_DRIVER_UBO) |
+              CP_LOAD_STATE6_0_STATE_TYPE(ST6_UBO)|
+              CP_LOAD_STATE6_0_STATE_SRC(SS6_DIRECT) |
+              CP_LOAD_STATE6_0_STATE_BLOCK(SB6_CS_SHADER) |
+              CP_LOAD_STATE6_0_NUM_UNIT(1));
+   tu_cs_emit(cs, CP_LOAD_STATE6_1_EXT_SRC_ADDR(0));
+   tu_cs_emit(cs, CP_LOAD_STATE6_2_EXT_SRC_ADDR_HI(0));
+   tu_cs_emit_qw(cs,
+                 params_ubo.iova |
+                 (uint64_t)A6XX_UBO_1_SIZE(num_units) << 32);
+}
+
+template <chip CHIP>
+static void
+tu_rt_common(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   if (cmd->state.dirty & TU_CMD_DIRTY_RT_DESC_SETS) {
+      tu6_emit_descriptor_sets<CHIP>(cmd, VK_PIPELINE_BIND_POINT_RAY_TRACING_KHR);
+   }
+
+   cmd->state.dirty &= ~TU_CMD_DIRTY_RT_DESC_SETS;
+   cmd->state.dirty |= TU_CMD_DIRTY_COMPUTE_DESC_SETS;
+
+   tu_emit_rt_params<CHIP>(cmd, cs);
+
+   tu_cs_emit_state_ib(cs, tu_emit_consts_rt<CHIP>(cmd));
+
+   /* AQE doesn't wait for pending WFIs to finish, so we need to insert a
+    * WAIT_FOR_ME if there is any pending. We also need to insert a
+    * CACHE_INVALIDATE, because at the beginning the AQE will write initial
+    * values to various temporaries and we may have stale values from previous
+    * DispatchRays() executions.
+    */
+   cmd->state.cache.flush_bits |=
+      (cmd->state.cache.pending_flush_bits & TU_CMD_FLAG_WAIT_FOR_ME) |
+      TU_CMD_FLAG_CACHE_INVALIDATE;
+   cmd->state.cache.pending_flush_bits &=
+      ~(TU_CMD_FLAG_WAIT_FOR_ME | TU_CMD_FLAG_CACHE_INVALIDATE);
+}
