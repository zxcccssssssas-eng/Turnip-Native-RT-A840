+static void
+tu_emit_sbt_direct(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
+                   const VkStridedDeviceAddressRegionKHR *raygen_sbt,
+                   const VkStridedDeviceAddressRegionKHR *miss_sbt,
+                   const VkStridedDeviceAddressRegionKHR *hit_sbt,
+                   const VkStridedDeviceAddressRegionKHR *callable_sbt)
+{
+   VkTraceRaysIndirectCommand2KHR sbt = {
+      .raygenShaderRecordAddress = raygen_sbt->deviceAddress,
+      .raygenShaderRecordSize = raygen_sbt->size,
+      .missShaderBindingTableAddress = miss_sbt->deviceAddress,
+      .missShaderBindingTableSize = miss_sbt->size,
+      .missShaderBindingTableStride = miss_sbt->stride,
+      .hitShaderBindingTableAddress = hit_sbt->deviceAddress,
+      .hitShaderBindingTableSize = hit_sbt->size,
+      .hitShaderBindingTableStride = hit_sbt->stride,
+      .callableShaderBindingTableAddress = callable_sbt->deviceAddress,
+      .callableShaderBindingTableSize = callable_sbt->size,
+      .callableShaderBindingTableStride = callable_sbt->stride,
+   };
+
+   unsigned num_units = sizeof(sbt) / 4;
+   struct tu_cs sub_cs;
+   VkResult result =
+      tu_cs_begin_sub_stream_aligned(&cmd->sub_cs, num_units, 4,
+                                     &sub_cs);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   tu_cs_emit_array(&sub_cs, (uint32_t *)&sbt, num_units);
+
+   struct tu_draw_state sbt_ubo = tu_cs_end_draw_state(&cmd->sub_cs, &sub_cs);
+
+   tu_cs_emit_pkt7(cs, CP_LOAD_STATE6_FRAG, 5);
+   tu_cs_emit(cs,
+              CP_LOAD_STATE6_0_DST_OFF(TU_RT_SBT_UBO) |
+              CP_LOAD_STATE6_0_STATE_TYPE(ST6_UBO)|
+              CP_LOAD_STATE6_0_STATE_SRC(SS6_DIRECT) |
+              CP_LOAD_STATE6_0_STATE_BLOCK(SB6_CS_SHADER) |
+              CP_LOAD_STATE6_0_NUM_UNIT(1));
+   tu_cs_emit(cs, CP_LOAD_STATE6_1_EXT_SRC_ADDR(0));
+   tu_cs_emit(cs, CP_LOAD_STATE6_2_EXT_SRC_ADDR_HI(0));
+   tu_cs_emit_qw(cs,
+                 sbt_ubo.iova |
+                 (uint64_t)A6XX_UBO_1_SIZE(num_units) << 32);
+}
+
+static void
+tu_emit_sbt_indirect(struct tu_cmd_buffer *cmd, struct tu_cs *cs,
+                     uint64_t iova)
+{
+   unsigned num_units = sizeof(VkTraceRaysIndirectCommand2KHR) / 4;
+
+   if (iova % 16 != 0) {
+      struct tu_cs sub_cs;
+      tu_cs_set_writeable(&cmd->sub_cs, true);
+      VkResult result =
+         tu_cs_begin_sub_stream_aligned(&cmd->sub_cs, num_units, 4,
+                                        &sub_cs);
+      if (result != VK_SUCCESS) {
+         tu_cs_set_writeable(&cmd->sub_cs, false);
+         vk_command_buffer_set_error(&cmd->vk, result);
+         return;
+      }
+      for (unsigned i = 0; i < num_units; i++)
+         tu_cs_emit(&sub_cs, 0);
+
+      struct tu_draw_state sbt_ubo = tu_cs_end_draw_state(&cmd->sub_cs, &sub_cs);
+      tu_cs_emit_pkt7(cs, CP_MEMCPY, 5);
+      tu_cs_emit_qw(cs, sbt_ubo.iova);
+      tu_cs_emit_qw(cs, iova);
+      tu_cs_emit(cs, num_units);
+
+      tu_cs_emit_pkt7(cs, CP_WAIT_MEM_WRITES, 0);
+      tu_cs_emit_pkt7(cs, CP_WAIT_FOR_ME, 0);
+
+      tu_cs_set_writeable(&cmd->sub_cs, false);
+
+      iova = sbt_ubo.iova;
+   }
+
+   tu_cs_emit_pkt7(cs, CP_LOAD_STATE6_FRAG, 5);
+   tu_cs_emit(cs,
+              CP_LOAD_STATE6_0_DST_OFF(TU_RT_SBT_UBO) |
+              CP_LOAD_STATE6_0_STATE_TYPE(ST6_UBO)|
+              CP_LOAD_STATE6_0_STATE_SRC(SS6_DIRECT) |
+              CP_LOAD_STATE6_0_STATE_BLOCK(SB6_CS_SHADER) |
+              CP_LOAD_STATE6_0_NUM_UNIT(1));
+   tu_cs_emit(cs, CP_LOAD_STATE6_1_EXT_SRC_ADDR(0));
+   tu_cs_emit(cs, CP_LOAD_STATE6_2_EXT_SRC_ADDR_HI(0));
+   tu_cs_emit_qw(cs,
+                 iova |
+                 (uint64_t)A6XX_UBO_1_SIZE(num_units) << 32);
+}
+
+static VkResult
+tu_ensure_rt_stack(struct tu_cmd_buffer *cmd)
+{
+   struct tu_device *dev = cmd->device;
+
+   uint32_t stack_size = cmd->state.rt_stack_size;
+   if (cmd->rt_stack_bo_size == 0 || cmd->rt_stack_bo_size < stack_size) {
+      struct tu_bo *new_bo = NULL;
+      uint32_t new_stack_size = 0;
+      VkResult result = VK_SUCCESS;
+      mtx_lock(&dev->rt_stack_mtx);
+      if (dev->rt_stack_size == 0 || dev->rt_stack_size < stack_size) {
+         if (dev->rt_stack_bo)
+            tu_bo_finish(dev, dev->rt_stack_bo);
+         result = tu_bo_init_new(dev, &dev->vk.base, &dev->rt_stack_bo,
+                                 stack_size *
+                                 dev->physical_device->info->max_rt_threads * 2,
+                                 TU_BO_ALLOC_INTERNAL_RESOURCE, "rt stack");
+         dev->rt_stack_size = stack_size;
+      }
+      if (result == VK_SUCCESS) {
+         new_bo = tu_bo_get_ref(dev->rt_stack_bo);
+         new_stack_size = dev->rt_stack_size;
+      }
+      mtx_unlock(&dev->rt_stack_mtx);
+
+      if (result != VK_SUCCESS) {
+         return result;
+      }
+
+      util_dynarray_append(&cmd->rt_stack_bos, new_bo);
+      cmd->rt_stack_bo = new_bo;
+      cmd->rt_stack_bo_size = new_stack_size;
+   }
+
+   return VK_SUCCESS;
+}
+
+static void
+tu_emit_rt_args(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   VkResult result = tu_ensure_rt_stack(cmd);
+   if (result != VK_SUCCESS) {
+      vk_command_buffer_set_error(&cmd->vk, result);
+      return;
+   }
+
+   struct tu_rt_pipeline *pipeline = cmd->state.rt_pipeline;
+   tu_cs_emit_qw(cs, cmd->device->rt_global_counts0_iova);
+   tu_cs_emit_qw(cs, cmd->device->rt_global_counts1_iova);
+   tu_cs_emit(cs, pipeline->total_subshaders + 1 + 1);
+   tu_cs_emit_qw(cs, pipeline->slot_to_shader_iova);
+   tu_cs_emit_qw(cs, pipeline->shader_to_slot_iova);
+   tu_cs_emit_qw(cs, pipeline->counts_iova);
+   tu_cs_emit(cs, cmd->device->physical_device->info->max_rt_threads);
+   tu_cs_emit_qw(cs, pipeline->pending_thread_ids_iova);
+   tu_cs_emit(cs, cmd->device->rt_scratch0_size);
+   tu_cs_emit_qw(cs, cmd->device->rt_scratch0_iova);
+   tu_cs_emit(cs, cmd->state.rt_stack_size);
+   tu_cs_emit_qw(cs, cmd->rt_stack_bo->iova);
+   tu_cs_emit_qw(cs, pipeline->shader_ibs_iova);
+   tu_cs_emit_qw(cs, pipeline->shader_ibs_size_iova);
+}
