+++ b/src/freedreno/ir3/ir3_a6xx.c
@@ -685,6 +685,9 @@ emit_intrinsic_atomic_global(struct ir3_context *ctx, nir_intrinsic_instr *intr)
    atomic->barrier_conflict = IR3_BARRIER_BUFFER_R | IR3_BARRIER_BUFFER_W;
    atomic->dsts[0]->wrmask = MASK(intr->def.bit_size == 64 ? 2 : 1);
 
+   if (nir_intrinsic_access(intr) & ACCESS_CROSS_DEVICE)
+      atomic->flags |= IR3_INSTR_SOC;
+
    /* even if nothing consume the result, we can't DCE the instruction: */
    array_insert(ctx->block, ctx->block->keeps, atomic);
 
