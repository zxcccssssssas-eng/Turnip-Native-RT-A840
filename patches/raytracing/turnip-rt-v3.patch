From: Connor Abbott <cwabbott0@gmail.com>
Date: Wed, 13 Nov 2024 12:16:50 -0500
Subject: [PATCH 01/33] freedreno: Document CP_AQE_COMMAND

---
 src/freedreno/registers/adreno/adreno_pm4.xml | 96 +++++++++++++++++++
 1 file changed, 96 insertions(+)

diff --git a/src/freedreno/registers/adreno/adreno_pm4.xml b/src/freedreno/registers/adreno/adreno_pm4.xml
index f185b541..7c156d73 100644
--- a/src/freedreno/registers/adreno/adreno_pm4.xml
+++ b/src/freedreno/registers/adreno/adreno_pm4.xml
@@ -658,6 +658,9 @@ xsi:schemaLocation="https://gitlab.freedesktop.org/freedreno/ rules-fd.xsd">
 	</doc>
 	<value name="CP_FIXED_STRIDE_DRAW_TABLE" value="0x7f" variants="A7XX-"/>
 
+	<doc>The contents of the packet are sent to AQE</doc>
+	<value name="CP_AQE_COMMAND" value="0x7a" variants="A7XX-"/>
+
 	<doc>Reset various on-chip state used for synchronization</doc>
 	<value name="CP_RESET_CONTEXT_STATE" value="0x1f" variants="A7XX-"/>
 
@@ -2443,5 +2446,98 @@ opcode: CP_LOAD_STATE4 (30) (4 dwords)
 	</reg64>
 </domain>
 
+<!-- See https://gitlab.freedesktop.org/freedreno/freedreno/-/wikis/AQE for details -->
+
+<enum name="aqe_opcode">
+	<value name="AQE_TRACE_RAYS_0" value="1"/>
+	<value name="AQE_TRACE_RAYS_1" value="2"/>
+	<value name="AQE_TRACE_RAYS_INDIRECT2" value="3"/> <!-- vkCmdTraceRaysIndirect2KHR -->
+	<value name="AQE_TRACE_RAYS_INDIRECT" value="4"/> <!-- vkCmdTraceRaysIndirectKHR -->
+	<value name="AQE_DISPATCH_MESH" value="5"/>
+	<value name="AQE_DISPATCH_MESH_INDIRECT" value="7"/>
+</enum>
+
+<domain name="CP_AQE_COMMAND" width="32">
+	<reg32 offset="0" name="0">
+		<bitfield name="OPCODE" low="0" high="3" type="aqe_opcode" addvariant="yes"/>
+	</reg32>
+	<stripe varset="aqe_opcode" variants="AQE_TRACE_RAYS_0">
+		<reg64 name="RAYGEN_SBT" offset="1" type="address"/>
+		<reg32 name="WIDTH" offset="3" type="uint"/>
+		<reg32 name="HEIGHT" offset="4" type="uint"/>
+		<reg32 name="DEPTH" offset="5" type="uint"/>
+		<reg64 name="GLOBAL_COUNT_0" offset="6" type="waddress"/>
+		<reg64 name="GLOBAL_COUNT_1" offset="8" type="waddress"/>
+		<reg32 name="SLOT_COUNT" offset="10" type="uint"/>
+		<reg64 name="SLOT_TO_SHADER" offset="11" type="waddress"/>
+		<reg64 name="SHADER_TO_SLOT" offset="13" type="waddress"/>
+		<reg64 name="COUNTS" offset="15" type="waddress"/>
+		<reg32 name="MAX_THREADS" offset="17" type="uint"/>
+		<reg64 name="PENDING_THREAD_IDS" offset="18" type="waddress"/>
+		<reg32 name="SCRATCH0_SIZE" offset="20" type="uint"/>
+		<reg64 name="SCRATCH0" offset="21" type="waddress"/>
+		<reg32 name="SCRATCH1_SIZE" offset="23" type="uint"/>
+		<reg64 name="SCRATCH1" offset="24" type="waddress"/>
+		<reg64 name="SHADER_IB_ADDRS" offset="26" type="address"/>
+		<reg64 name="SHADER_IB_LENGTHS" offset="28" type="address"/>
+	</stripe>
+	<stripe varset="aqe_opcode" variants="AQE_TRACE_RAYS_1">
+		<reg64 name="RAYGEN_SBT" offset="1" type="address"/>
+		<reg32 name="WIDTH" offset="3" type="uint"/>
+		<reg32 name="HEIGHT" offset="4" type="uint"/>
+		<reg32 name="DEPTH" offset="5" type="uint"/>
+		<reg64 name="GLOBAL_COUNT_0" offset="6" type="waddress"/>
+		<reg64 name="GLOBAL_COUNT_1" offset="8" type="waddress"/>
+		<reg32 name="SLOT_COUNT" offset="10" type="uint"/>
+		<reg64 name="SLOT_TO_SHADER" offset="11" type="waddress"/>
+		<reg64 name="SHADER_TO_SLOT" offset="13" type="waddress"/>
+		<reg64 name="COUNTS" offset="15" type="waddress"/>
+		<reg32 name="MAX_THREADS" offset="17" type="uint"/>
+		<reg64 name="PENDING_THREAD_IDS" offset="18" type="waddress"/>
+		<reg32 name="SCRATCH0_SIZE" offset="20" type="uint"/>
+		<reg64 name="SCRATCH0" offset="21" type="waddress"/>
+		<reg32 name="SCRATCH1_SIZE" offset="23" type="uint"/>
+		<reg64 name="SCRATCH1" offset="24" type="waddress"/>
+		<reg64 name="SHADER_IB_ADDRS" offset="26" type="address"/>
+		<reg64 name="SHADER_IB_LENGTHS" offset="28" type="address"/>
+	</stripe>
+	<stripe varset="aqe_opcode" variants="AQE_TRACE_RAYS_INDIRECT2">
+		<reg64 name="INDIRECT_COMMAND" offset="1" type="address"/>
+		<reg64 name="GLOBAL_COUNT_0" offset="2" type="waddress"/>
+		<reg64 name="GLOBAL_COUNT_1" offset="4" type="waddress"/>
+		<reg32 name="SLOT_COUNT" offset="6" type="uint"/>
