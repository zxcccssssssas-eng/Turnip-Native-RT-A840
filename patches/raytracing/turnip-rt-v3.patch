From 7f303dd8503b9c4b15e99acea3b4d87572449940 Mon Sep 17 00:00:00 2001
From: Connor Abbott <cwabbott0@gmail.com>
Date: Thu, 2 Jan 2025 13:06:19 -0500
Subject: [PATCH 04/33] freedreno/crashdec: Try to dump AQE0 stack

---
 src/freedreno/decode/crashdec.c | 59 ++++++++++++++++++++++++++++++++-
 src/freedreno/decode/snapshot.h |  4 +--
 2 files changed, 60 insertions(+), 3 deletions(-)

diff --git a/src/freedreno/decode/crashdec.c b/src/freedreno/decode/crashdec.c
index b8ad8cb9..f1b82956 100644
--- a/src/freedreno/decode/crashdec.c
+++ b/src/freedreno/decode/crashdec.c
@@ -650,7 +650,7 @@ decode_bos(void)
          add_buffer(iova, size, buf);
 
          if (size <= 0x40000)
-            snapshot_gpu_object(iova, size, buf);
+            snapshot_gpu_object(SNAPSHOT_GPU_OBJECT_GENERIC, iova, size, buf);
 
          continue;
       }
@@ -918,6 +918,11 @@ const static struct {
    {"CP_BV_MEMPOOL", "CP_BV_MEM_POOL_DBG"},
 };
 
+static uint32_t aqe0_stack_base = 0;
+static uint32_t aqe0_sp = 0;
+static uint32_t aqe1_stack_base = 0;
+static uint32_t aqe1_sp = 0;
+
 static void
 decode_indexed_registers(void)
 {
@@ -955,6 +960,19 @@ decode_indexed_registers(void)
              !strcmp(name, "CP_AQE_STAT_0") || !strcmp(name, "CP_AQE_STAT_1"))
             dump_cp_sqe_stat(buf);
 
+         if (!strcmp(name, "CP_AQE_STAT_0")) {
+            /* By convention: $17 contains the stack base, $1a contains the
+             * stack pointer (and is disassembled as $sp).
+             */
+            aqe0_stack_base = buf[0x17];
+            aqe0_sp = buf[0x1a];
+         }
+
+         if (!strcmp(name, "CP_AQE_STAT_1")) {
+            aqe1_stack_base = buf[0x17];
+            aqe1_sp = buf[0x1a];
+         }
+
          if (!strcmp(name, "CP_SQE_UCODE_DBG") ||
              !strcmp(name, "CP_BV_SQE_UCODE_DBG") ||
              !strcmp(name, "CP_AQE_UCODE_DBG_0") ||
@@ -1056,6 +1074,43 @@ decode_shader_blocks(void)
    free(pipe);
 }
 
+static void
+decode_preemption_records(void)
+{
+   uint64_t iova;
+   uint32_t size;
+
+   foreach_line_in_section (line) {
+      if (startswith(line, "    iova:")) {
+         parseline(line, "    iova: %" PRIx64, &iova);
+      } else if (startswith(line, "    size:")) {
+         parseline(line, "    size: %u", &size);
+      } else if (startswith(line, "    data: !!ascii85 |")) {
+         void *buf = popline_ascii85(size / 4);
+
+         snapshot_gpu_object(SNAPSHOT_GPU_OBJECT_GLOBAL, iova, size, buf);
+         add_buffer(iova, size, buf);
+
+         continue;
+      }
+
+      printf("%s", line);
+   }
+
+   /* Try to dump AQE stack. To recover the high 32 bits, which are stored
+    * implicitly in LOAD_STORE_HI, assume that all preemption records have the
+    * same high 32 bits and use the last one.
+    */
+   if (aqe0_sp != 0) {
+      uint64_t aqe0_stack_iova = (iova & 0xffffffff0000000) | aqe0_sp;
+      void *aqe0_stack = hostptr(aqe0_stack_iova);
+      if (aqe0_stack) {
+         printf("   AQE0 stack:\n");
+         dump_hex_ascii(aqe0_stack, aqe0_stack_base + 0x4000 - aqe0_sp, 1);
+      }
+   }
+}
+
 /*
  * Decode debugbus section:
  */
@@ -1201,6 +1256,8 @@ decode(void)
          decode_clusters();
       } else if (startswith(line, "debugbus:")) {
          decode_debugbus();
+      } else if (startswith(line, "preempt-records:")) {
+         decode_preemption_records();
       }
    }
 }
