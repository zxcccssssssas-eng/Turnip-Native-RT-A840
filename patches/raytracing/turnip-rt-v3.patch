+static void
+tu_rt_restore_compute(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   if (cmd->state.shaders[MESA_SHADER_COMPUTE])
+      tu_cs_emit_state_ib(cs, cmd->state.shaders[MESA_SHADER_COMPUTE]->state);
+}
