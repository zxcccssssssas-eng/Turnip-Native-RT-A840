+nir_def *
+tu_load_tlas(nir_builder *b, nir_def *tlas,
+             nir_def *uav_index, nir_def *index,
+             unsigned offset, unsigned components)
+{
+   if (uav_index) {
+      return nir_load_uav_ir3(b, components, 32, uav_index,
+                              nir_vec2(b, index, nir_imm_int(b, offset / 4)),
