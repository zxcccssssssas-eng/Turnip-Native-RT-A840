+/*
+ * From section 40.3 Shader Binding Table:
+ *
+ *    Each entry in the shader binding table consists of shaderGroupHandleSize
+ *    bytes of data, either as queried by vkGetRayTracingShaderGroupHandlesKHR
+ *    to refer to those specified shaders, or all zeros to refer to a zero
+ *    shader group. A zero shader group behaves as though it is a shader group
+ *    consisting entirely of VK_SHADER_UNUSED_KHR.
+ *
+ * By making the handle for VK_SHADER_UNUSED_KHR 0, we make it easy to
+ * implement this. Shader 0 is the traversal shader, which is only called
+ * internally, so we reuse it to mean an unused shader when in the SBT. Shader
+ * code should check whether the index is TU_SHADER_UNUSED before spawning the
+ * shader.
+ */
+#define TU_SHADER_UNUSED ((uint32_t)0)
+
+struct tu_pipeline_group_handle {
+   union {
+      uint32_t general_index;
+      uint32_t closest_hit_index;
+   };
+   union {
+      uint32_t intersection_index;
+      uint32_t any_hit_index;
+   };
+};
+
+struct tu_rt_shader_group {
+   VkRayTracingShaderGroupTypeKHR type;
+   union {
+      struct tu_rt_shader *general;
+      struct tu_rt_shader *closest_hit;
+   };
+   union {
+      struct tu_rt_shader *intersection;
+      struct tu_rt_shader *any_hit;
+   };
+   struct tu_pipeline_group_handle handle;
+};
+
+/* Each compiled ray tracing shader consists of an initial shader and zero or
+ * more resume shaders that must be added to the array of shaders separately.
+ * These must be cached together.
+ */
+struct tu_rt_shader {
+   struct vk_pipeline_cache_object base;
+
+   mesa_shader_stage stage;
+
+   struct tu_shader **shaders;
+   unsigned shader_count;
+
+   uint32_t stack_size;
+};
+
+/* We only get to bind these UBOs once before calling into the AQE, so all
+ * shaders must agree on its location.
+ */
+
+/* Contains the stack size, counts pointer, and thread ID array pointer. */
+#define TU_RT_DRIVER_UBO 1
+
+struct tu_rt_params {
+   uint64_t counts_addr;
+   uint64_t pending_thread_ids_addr;
+   uint32_t stack_size;
+   uint32_t padding[3];
+};
+
+/* Contains VkTraceRaysIndirectCommand2KHR, minus the width/height/depth which
+ * may not be specified by the driver if the TraceRays is direct.
+ */
+#define TU_RT_SBT_UBO 2
+
+/* Contains addresses of inline UBOs.
+ */
+#define TU_RT_INLINE_UBO 3
+
+#define TU_RT_NUM_UBOS 4
+
+struct tu_rt_pipeline {
+   struct tu_pipeline base;
+
+   /* Holds:
+    * - shader_to_slot
+    * - slot_to_shader
+    * - counts
+    * - pending_thread_ids
+    *
+    * All of these are scratch buffers used by firmware/shaders whose size
+    * only depends on the number of shaders.
+    */
+   struct tu_bo *scratch_bo;
+
+   struct tu_const_state const_state;
+
+   uint64_t shader_to_slot_iova;
+   uint64_t slot_to_shader_iova;
+   uint64_t counts_iova;
+   uint64_t pending_thread_ids_iova;
+
+   struct tu_rt_shader_group *groups;
+   struct tu_rt_shader **shaders;
+   unsigned group_count, shader_count;
+
+   uint32_t total_subshaders;
+   uint32_t stack_size;
+
+   uint64_t shader_ibs_iova, shader_ibs_size_iova;
+};
+
