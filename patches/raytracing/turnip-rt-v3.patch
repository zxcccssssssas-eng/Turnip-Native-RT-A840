+++ b/src/freedreno/ir3/ir3.h
@@ -3119,10 +3119,12 @@ ir3_BRCST_ACTIVE(struct ir3_builder *build, unsigned cluster_size,
 INSTR0(GETFIBERID)
 INSTR2(LDLV)
 INSTR3(LDG)
+INSTR3(LDTHR)
 INSTR3(LDL)
 INSTR3(LDLW)
 INSTR3(LDP)
 INSTR4NODST(STG)
+INSTR4NODST(STTHR)
 INSTR3NODST(STL)
 INSTR3NODST(STLW)
 INSTR3NODST(STP)
@@ -3154,7 +3156,9 @@ INSTR2(SHFL)
 INSTR4NODST(STIB);
 INSTR3(LDIB);
 INSTR5(LDG_A);
+INSTR5(LDTHR_A);
 INSTR6NODST(STG_A);
+INSTR6NODST(STTHR_A);
 INSTR2(ATOMIC_G_ADD)
 INSTR2(ATOMIC_G_SUB)
 INSTR2(ATOMIC_G_XCHG)
diff --git a/src/freedreno/ir3/ir3_a6xx.c b/src/freedreno/ir3/ir3_a6xx.c
index d0c45d63..f9ab10e2 100644
--- a/src/freedreno/ir3/ir3_a6xx.c
+++ b/src/freedreno/ir3/ir3_a6xx.c
@@ -572,11 +572,21 @@ emit_intrinsic_load_global_ir3(struct ir3_context *ctx,
    struct ir3_instruction *load;
 
    if (!offset.src) {
-      load = ir3_LDG(b, addr, 0, offset.imm, 0,
-                     create_immed(b, dest_components), 0);
+      if (nir_intrinsic_access(intr) & ACCESS_NON_TEMPORAL) {
+         load = ir3_LDTHR(b, addr, 0, offset.imm, 0,
+                          create_immed(b, dest_components), 0);
+      } else {
+         load = ir3_LDG(b, addr, 0, offset.imm, 0,
+                        create_immed(b, dest_components), 0);
+      }
    } else {
-      load = ir3_LDG_A(b, addr, 0, offset.src, 0, offset.src_shift, 0,
