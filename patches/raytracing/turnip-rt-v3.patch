From 731c51748ee943649e80ec97f401cca433bb08ea Mon Sep 17 00:00:00 2001
From: Connor Abbott <cwabbott0@gmail.com>
Date: Fri, 10 Jan 2025 16:59:16 -0500
Subject: [PATCH 08/33] nir/load_store_vectorize: Don't vectorize across call
 instructions

Fixes
dEQP-VK.ray_tracing_pipeline.callable_shader.callable_shader_invoked_via_closest_hit_single_invocation
and a few others on turnip. The test writes the first three variables
of an SSBO in the closest hit shader, then calls a callable shader which
overwrites the first variable, then writes the last variable. We can't
combine the writes before and after the call.
---
 src/compiler/nir/nir_opt_load_store_vectorize.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/compiler/nir/nir_opt_load_store_vectorize.c b/src/compiler/nir/nir_opt_load_store_vectorize.c
index fc416c49..816f9b88 100644
--- a/src/compiler/nir/nir_opt_load_store_vectorize.c
+++ b/src/compiler/nir/nir_opt_load_store_vectorize.c
@@ -1763,6 +1763,14 @@ handle_barrier(struct vectorize_ctx *ctx, bool *progress, nir_function_impl *imp
       case nir_intrinsic_launch_mesh_workgroups:
          modes = nir_var_all;
          break;
+      /* These are effectively function calls and the shaders they call may
+       * modify globally-visible memory.
+       */
+      case nir_intrinsic_trace_ray:
+      case nir_intrinsic_report_ray_intersection:
+      case nir_intrinsic_execute_callable:
+         modes = nir_var_mem_ssbo | nir_var_mem_global;
+         break;
       case nir_intrinsic_demote_if:
       case nir_intrinsic_demote:
          acquire = false;
-- 
