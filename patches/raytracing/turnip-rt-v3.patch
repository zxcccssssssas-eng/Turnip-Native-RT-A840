From 344150642066714ba3e472b23169f4cf73852296 Mon Sep 17 00:00:00 2001
From: Connor Abbott <cwabbott0@gmail.com>
Date: Tue, 31 Dec 2024 12:16:01 -0500
Subject: [PATCH 02/33] freedreno/decode: Support CP_AQE_COMMAND

For ray tracing opcodes, support displaying, and modifying when
replaying, shader IBs. Also support dumping key temporary
datastructures, which is useful for devcoredumps to debug hangs.
---
 src/freedreno/decode/cffdec.c           | 107 ++++++++++++++++++++++++
 src/freedreno/decode/rdcompiler-utils.h |  16 ++++
 src/freedreno/decode/rddecompiler.c     |  83 ++++++++++++++++++
 3 files changed, 206 insertions(+)

diff --git a/src/freedreno/decode/cffdec.c b/src/freedreno/decode/cffdec.c
index b444f9c0..2555cf76 100644
--- a/src/freedreno/decode/cffdec.c
+++ b/src/freedreno/decode/cffdec.c
@@ -2594,6 +2594,112 @@ cp_run_cl(const uint32_t *dwords, uint32_t sizedwords, int level)
    dump_register_summary(level, "compute");
 }
 
+static uint64_t
+get_qword(const uint32_t *dwords, uint32_t dword_offset)
+{
+   return ((uint64_t)dwords[dword_offset + 1] << 32) |
+      dwords[dword_offset];
+}
+
+static void
+cp_aqe_command(const uint32_t *dwords, uint32_t sizedwords, int level)
+{
+   struct rnndomain *domain = rnn_finddomain(rnn->db, "CP_AQE_COMMAND");
+   
+   uint32_t ib_addrs_dword = rnndec_decodereg(rnn->vc, domain, "SHADER_IB_ADDRS");
+   uint32_t ib_sizes_dword = rnndec_decodereg(rnn->vc, domain, "SHADER_IB_LENGTHS");
+   uint32_t slot_count_dword = rnndec_decodereg(rnn->vc, domain, "SLOT_COUNT");
+   uint32_t raygen_sbt_dword = rnndec_decodereg(rnn->vc, domain, "RAYGEN_SBT");
+
+   if (raygen_sbt_dword) {
+      uint64_t raygen_sbt_addr =
+         ((uint64_t)dwords[raygen_sbt_dword + 1] << 32) |
+         dwords[raygen_sbt_dword];
+      uint32_t *raygen_sbt = hostptr(raygen_sbt_addr);
+      if (raygen_sbt) {
+         printf("%sraygen sbt index: %u\n", levels[level], *raygen_sbt);
+      }
+   }
+
+   if (ib_addrs_dword) {
+      uint32_t counts_dword =
+         rnndec_decodereg(rnn->vc, domain, "COUNTS");
+      uint32_t global_counts_dword =
+         rnndec_decodereg(rnn->vc, domain, "GLOBAL_COUNT_0");
+      uint32_t slot_to_shader_dword =
+         rnndec_decodereg(rnn->vc, domain, "SLOT_TO_SHADER");
+      uint64_t ib_addrs_addr = get_qword(dwords, ib_addrs_dword);
+      uint64_t ib_sizes_addr = get_qword(dwords, ib_sizes_dword);
+      uint64_t counts_addr = get_qword(dwords, counts_dword);
+      uint64_t slot_to_shader_addr = get_qword(dwords, slot_to_shader_dword);
+      uint64_t global_counts_addr[2];
+      global_counts_addr[0] = get_qword(dwords, global_counts_dword);
+      global_counts_addr[1] = get_qword(dwords, global_counts_dword + 2);
+      uint32_t slot_count = dwords[slot_count_dword];
+      uint32_t shader_count = slot_count - 1;
+
+      uint32_t *counts = hostptr(counts_addr);
+      if (counts) {
+         for (unsigned ctxt = 0; ctxt < 2; ctxt++) {
+            printl(3, "%scounts ctxt %u: ", levels[level], ctxt);
+            for (unsigned i = 0; i < slot_count; i++) {
+               printf("%u ", counts[slot_count * ctxt + i]);
+            }
+            printf("\n");
+         }
+      }
+
+      uint32_t *slot_to_shader = hostptr(slot_to_shader_addr);
+      if (slot_to_shader) {
+         for (unsigned ctxt = 0; ctxt < 2; ctxt++) {
+            printl(3, "%sslot_to_shader ctxt %u: ", levels[level], ctxt);
+            for (unsigned i = 0; i < slot_count; i++) {
+               printf("%u ", slot_to_shader[slot_count * ctxt + i]);
+            }
+            printf("\n");
+         }
+      }
+
+      uint32_t *global_counts[2];
+      global_counts[0] = hostptr(global_counts_addr[0]);
+      global_counts[1] = hostptr(global_counts_addr[1]);
+      if (global_counts[0]) {
+         for (unsigned ctxt = 0; ctxt < 2; ctxt++) {
+               printl(3, "%sglobal counts ctxt %u: ", levels[level], ctxt);
+               for (unsigned i = 0; i < 4; i++) {
+                  printf("%u ", global_counts[ctxt][i]);
+               }
+               printf("\n");
+         }
+      }
+
+      uint64_t *ib_addrs = hostptr(ib_addrs_addr);
+      uint32_t *ib_sizes = hostptr(ib_sizes_addr);
+      if (ib_addrs && ib_sizes) {
+         ib++;
+         for (unsigned i = 0; i < shader_count; i++) {
+            uint32_t *ib_ptr = hostptr(ib_addrs[i]);
+            if (ib_ptr) {
+               printl(3, "%sshader %u:\n", levels[level], i);
+               if (!quiet(3)) {
+                  printf("%sibaddr:%016" PRIx64 "\n", levels[level], ib_addrs[i]);
+                  printf("%sibsize:%08x\n", levels[level], ib_sizes[i]);
+               }
+               ibs[ib].base = ib_addrs[i];
+               ibs[ib].size = ib_sizes[i];
+               dump_commands(ib_ptr, ib_sizes[i], level);
+            }
+         }
+         ib--;
+      }
+   }
+
+   /* Decoding IBs may have reset this. */
+   current_pkt = "CP_AQE_COMMAND";
+
+   dump_bindless_descriptors(true, level);
+}
+
 static void
 print_nop_tail_string(const uint32_t *dwords, uint32_t sizedwords)
 {
@@ -3290,6 +3396,7 @@ static const struct type3_op {
    CP(DRAW_INDIRECT, cp_draw_indirect, {.load_all_groups = true}),
    CP(DRAW_INDX_INDIRECT, cp_draw_indx_indirect, {.load_all_groups = true}),
    CP(DRAW_INDIRECT_MULTI, cp_draw_indirect_multi, {.load_all_groups = true}),
+   CP(AQE_COMMAND, cp_aqe_command),
    CP(SKIP_IB2_ENABLE_GLOBAL, cp_skip_ib2_enable_global),
    CP(SKIP_IB2_ENABLE_LOCAL, cp_skip_ib2_enable_local),
 
diff --git a/src/freedreno/decode/rdcompiler-utils.h b/src/freedreno/decode/rdcompiler-utils.h
index 13ccb563..2f56c7d4 100644
--- a/src/freedreno/decode/rdcompiler-utils.h
+++ b/src/freedreno/decode/rdcompiler-utils.h
@@ -378,6 +378,22 @@ emit_shader_iova_reg_bunch(struct replay_context *ctx, struct cmdstream *cs,
    pkt_qw(prev_cs, cs->iova);                                                  \
    pkt(prev_cs, ibcs_size);
 
+#define begin_rt()                                                             \
+   struct cmdstream *ib_addrs = cs_alloc(&ctx, 1024 * 8);                      \
+   struct cmdstream *ib_sizes = cs_alloc(&ctx, 1024 * 4);                      \
+
+#define begin_rt_ib()                                                          \
+   struct cmdstream *cs = cs_alloc(&ctx, 1024 * 1024);                         \
+
+#define end_rt_ib()                                                            \
+   uint64_t ibcs_size = cs->cur;                                               \
+   pkt_qw(ib_addrs, cs->iova);                                                 \
+   pkt(ib_sizes, ibcs_size);
+
+#define end_rt()                                                               \
+   pkt_qw(cs, ib_addrs->iova);                                                 \
+   pkt_qw(cs, ib_sizes->iova);
+
 UNUSED static void
 gpu_print(struct replay_context *ctx, struct cmdstream *_cs, uint64_t iova,
           uint32_t dwords)
diff --git a/src/freedreno/decode/rddecompiler.c b/src/freedreno/decode/rddecompiler.c
index 8c3c2197..d948a7e9 100644
--- a/src/freedreno/decode/rddecompiler.c
+++ b/src/freedreno/decode/rddecompiler.c
@@ -435,6 +435,87 @@ decompile_domain(uint32_t pkt, const uint32_t *dwords, uint32_t sizedwords,
    }
 }
 
+static void
+decompile_commands(const uint32_t *dwords, uint32_t sizedwords, int level,
+                   uint32_t *cond_count);
+
+static void
+decompile_aqe(const uint32_t *dwords, uint32_t sizedwords, int level)
+{
+   struct rnndomain *dom;
+   int i;
+
+   dom = rnn_finddomain(rnn->db, "CP_AQE_COMMAND");
+
+   printlvl(level, "pkt7(cs, CP_AQE_COMMAND, %u);\n", sizedwords);
+
+   uint32_t slot_count = 0;
+
+   for (i = 0; i < sizedwords; i++) {
+      struct rnndecaddrinfo *info = NULL;
+      if (dom) {
+         info = rnndec_decodeaddr(rnn->vc, dom, i, 0);
+      }
+
+      if (strcmp(info->name, "SLOT_COUNT") == 0) {
+         slot_count = dwords[i];
+      }
+
+      if (strcmp(info->name, "SHADER_IB_ADDRS") == 0) {
+         uint64_t ibaddrs_addr = dwords[i] | ((uint64_t)dwords[i+1] << 32);
+         uint64_t ibsizes_addr = dwords[i+2] | ((uint64_t)dwords[i+3] << 32);
+         uint64_t *ibaddrs = hostptr(ibaddrs_addr);
+         uint32_t *ibsizes = hostptr(ibsizes_addr);
+
+         printlvl(level, "{\n");
+         printlvl(level + 1, "begin_rt();\n");
+
+         for (unsigned j = 0; j < slot_count - 1; j++) {
+            uint64_t ibaddr = ibaddrs[j];
+            uint32_t ibsize = ibsizes[j];
+
+            printlvl(level + 1, "/* shader %u */ {\n", j);
+            printlvl(level + 2, "begin_rt_ib();\n");
+
+            uint32_t *ptr = hostptr(ibaddr);
+            decompile_commands(ptr, ibsize, level + 2, NULL);
+
+            printlvl(level + 2, "end_rt_ib();\n");
+            printlvl(level + 1, "}\n");
+         }
+
+         printlvl(level + 1, "end_rt();\n");
+         printlvl(level, "}\n");
+
+         i += 3; /* skip subsequent 3 dwords (emitted by end_rt()) */
+         continue;
+      }
+
+      char *decoded;
+      if (!(info && info->typeinfo)) {
+         printlvl(level, "pkt(cs, 0x%x);\n", dwords[i]);
+         continue;
+      }
+      uint64_t value = dwords[i];
+      bool reg64 = info->typeinfo->high >= 32 && i < sizedwords - 1;
+      if (reg64) {
+         value |= (uint64_t)dwords[i + 1] << 32;
+      }
+      decoded = rnndec_decodeval(rnn->vc, info->typeinfo, value);
+
+      printlvl(level, "/* %s */\n", decoded);
+      printlvl(level, "pkt(cs, 0x%x);\n", dwords[i]);
+      if (reg64) {
+         printlvl(level, "pkt(cs, 0x%x);\n", dwords[i + 1]);
+         i++;
+      }
+
+      free(decoded);
+      free(info->name);
+      free(info);
+   }
+}
+
 static void
 decompile_commands(const uint32_t *dwords, uint32_t sizedwords, int level,
                    uint32_t *cond_count)
@@ -567,6 +648,8 @@ decompile_commands(const uint32_t *dwords, uint32_t sizedwords, int level,
                decompile_domain(val, dwords + 1, count - 1, dom_name, packet_name,
                                 level);
             }
+         } else if (val == CP_AQE_COMMAND) {
+            decompile_aqe(dwords + 1, count - 1, level);
          } else {
             const char *packet_name = pktname(val);
             const char *dom_name = packet_name;
-- 
