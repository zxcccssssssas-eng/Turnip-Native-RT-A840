+    const VkStridedDeviceAddressRegionKHR*      pHitShaderBindingTable,
+    const VkStridedDeviceAddressRegionKHR*      pCallableShaderBindingTable,
+    uint32_t                                    width,
+    uint32_t                                    height,
+    uint32_t                                    depth)
+{
+   VK_FROM_HANDLE(tu_cmd_buffer, cmd, commandBuffer);
+   struct tu_cs *cs = &cmd->cs;
+
+   tu_rt_common<CHIP>(cmd, cs);
+   tu_emit_sbt_direct(cmd, cs, pRaygenShaderBindingTable,
+                      pMissShaderBindingTable, pHitShaderBindingTable,
+                      pCallableShaderBindingTable);
+
+   tu_emit_cache_flush<CHIP>(cmd);
+
+   tu_cs_emit_pkt7(cs, CP_AQE_COMMAND, 30);
+   tu_cs_emit(cs, CP_AQE_COMMAND_0_OPCODE(AQE_TRACE_RAYS_1));
+   tu_cs_emit_qw(cs, pRaygenShaderBindingTable->deviceAddress);
+   tu_cs_emit(cs, width);
+   tu_cs_emit(cs, height);
+   tu_cs_emit(cs, depth);
+   tu_emit_rt_args(cmd, cs);
+
+   tu_rt_restore_compute(cmd, cs);
+}
+TU_GENX(tu_CmdTraceRaysKHR);
