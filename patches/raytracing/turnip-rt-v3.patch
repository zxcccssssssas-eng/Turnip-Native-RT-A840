From ea4a206319b142fdc9bf5caf83fb098833c99eb6 Mon Sep 17 00:00:00 2001
From: Connor Abbott <cwabbott0@gmail.com>
Date: Tue, 31 Dec 2024 15:22:31 -0500
Subject: [PATCH 03/33] freedreno/crashdec: Decode AQE data

These RAMs are exactly the same as the equivalent SQE/BR/BV RAMs.
---
 src/freedreno/decode/crashdec.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/freedreno/decode/crashdec.c b/src/freedreno/decode/crashdec.c
index 0b48f3e9..b8ad8cb9 100644
--- a/src/freedreno/decode/crashdec.c
+++ b/src/freedreno/decode/crashdec.c
@@ -951,11 +951,14 @@ decode_indexed_registers(void)
                      !strcmp(name, "CP_DRAW_STATE") ||
                      !strcmp(name, "CP_ROQ_DBG") || 0;
 
-         if (!strcmp(name, "CP_SQE_STAT") || !strcmp(name, "CP_BV_SQE_STAT"))
+         if (!strcmp(name, "CP_SQE_STAT") || !strcmp(name, "CP_BV_SQE_STAT") ||
+             !strcmp(name, "CP_AQE_STAT_0") || !strcmp(name, "CP_AQE_STAT_1"))
             dump_cp_sqe_stat(buf);
 
          if (!strcmp(name, "CP_SQE_UCODE_DBG") ||
-             !strcmp(name, "CP_BV_SQE_UCODE_DBG"))
+             !strcmp(name, "CP_BV_SQE_UCODE_DBG") ||
+             !strcmp(name, "CP_AQE_UCODE_DBG_0") ||
+             !strcmp(name, "CP_AQE_UCODE_DBG_1"))
             dump_cp_ucode_dbg(buf);
 
          if (!strcmp(name, "CP_MEM_POOL_DBG"))
-- 
