From 15b0385e72c9d53bfe16d13dcfcc95196b3ded90 Mon Sep 17 00:00:00 2001
From: Connor Abbott <cwabbott0@gmail.com>
Date: Mon, 13 Jul 2026 17:54:36 -0400
Subject: [PATCH 21/33] nir, ir3: Add invalidate_address_ir3 intrinsic

---
 src/compiler/nir/nir_intrinsics.py   |  5 +++
 src/compiler/nir/nir_lower_io.c      |  1 +
 src/freedreno/ir3/ir3_a6xx.c         | 54 +++++++++++++++++++++++++---
 src/freedreno/ir3/ir3_compiler_nir.c |  3 ++
 src/freedreno/ir3/ir3_context.h      |  2 ++
 5 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/src/compiler/nir/nir_intrinsics.py b/src/compiler/nir/nir_intrinsics.py
index 205f18a2..a3a3bd7a 100644
--- a/src/compiler/nir/nir_intrinsics.py
+++ b/src/compiler/nir/nir_intrinsics.py
@@ -1658,6 +1658,11 @@ store("global_ir3", [1, 1], indices=[ACCESS, ALIGN_MUL, ALIGN_OFFSET, OFFSET_SHI
 # Final address is calculated as for @store_global_ir3
 load("global_ir3", [1, 1], indices=[ACCESS, ALIGN_MUL, ALIGN_OFFSET, RANGE_BASE, RANGE, OFFSET_SHIFT, BASE], flags=[CAN_ELIMINATE])
 
+# Invalidate CCHE/UCHE at the given address so that the next load fetches from
+# main memory/LLC.
+# This has the same sources as load_global_offset.
+intrinsic("invalidate_address_ir3", [1, 1], indices=[ALIGN_MUL, ALIGN_OFFSET, OFFSET_SHIFT, BASE, BIT_SIZE, NUM_COMPONENTS])
+
 # Etnaviv-specific load/glboal intrinsics. They take a 32-bit base address and
 # a 32-bit offset, which doesn't need to be an immediate.
 # src[] = { value, address, 32-bit offset }.
diff --git a/src/compiler/nir/nir_lower_io.c b/src/compiler/nir/nir_lower_io.c
index 84c6eecc..c5ff3829 100644
--- a/src/compiler/nir/nir_lower_io.c
+++ b/src/compiler/nir/nir_lower_io.c
@@ -1044,6 +1044,7 @@ nir_get_io_offset_src_number(const nir_intrinsic_instr *instr)
    case nir_intrinsic_load_global_constant_offset:
    case nir_intrinsic_load_global_constant_bounded:
    case nir_intrinsic_load_global_ir3:
+   case nir_intrinsic_invalidate_address_ir3:
    case nir_intrinsic_store_output:
    case nir_intrinsic_store_pixel_local:
    case nir_intrinsic_store_shared:
diff --git a/src/freedreno/ir3/ir3_a6xx.c b/src/freedreno/ir3/ir3_a6xx.c
index f9ab10e2..a96d5442 100644
--- a/src/freedreno/ir3/ir3_a6xx.c
+++ b/src/freedreno/ir3/ir3_a6xx.c
@@ -499,15 +499,26 @@ static struct ldg_stg_offset
 ldg_stg_offset(struct ir3_context *ctx, nir_intrinsic_instr *intr)
 {
    assert(intr->intrinsic == nir_intrinsic_load_global_ir3 ||
-          intr->intrinsic == nir_intrinsic_store_global_ir3);
+          intr->intrinsic == nir_intrinsic_store_global_ir3 ||
+          intr->intrinsic == nir_intrinsic_invalidate_address_ir3);
 
    if (ctx->compiler->gen >= 7) {
       assert(nir_intrinsic_offset_shift(intr) == 0);
    } else {
-      ASSERTED unsigned bit_size =
-         intr->intrinsic == nir_intrinsic_load_global_ir3
-            ? intr->def.bit_size
-            : intr->src[0].ssa->bit_size;
+      ASSERTED unsigned bit_size;
+      switch (intr->intrinsic) {
+      case nir_intrinsic_load_global_ir3:
+         bit_size = intr->def.bit_size;
+         break;
+      case nir_intrinsic_store_global_ir3:
+         bit_size = intr->src[0].ssa->bit_size;
+         break;
+      case nir_intrinsic_invalidate_address_ir3:
+         bit_size = nir_intrinsic_bit_size(intr);
+         break;
+      default:
+         UNREACHABLE("invalid intrinsic");
+      }
       assert(nir_intrinsic_offset_shift(intr) == ffs(bit_size / 8) - 1);
    }
 
@@ -598,6 +609,37 @@ emit_intrinsic_load_global_ir3(struct ir3_context *ctx,
    ir3_split_dest(b, dst, load, 0, dest_components);
 }
 
+static void
+emit_intrinsic_invalidate_address_ir3(struct ir3_context *ctx,
+                                      nir_intrinsic_instr *intr)
+{
+   struct ir3_builder *b = &ctx->build;
+   unsigned dest_components = nir_intrinsic_num_components(intr);
+   unsigned dest_bit_size = nir_intrinsic_bit_size(intr);
+   struct ir3_instruction *addr;
+
+   addr = ir3_collect(b, ir3_get_src(ctx, &intr->src[0])[0]);
+
+   struct ldg_stg_offset offset = ldg_stg_offset(ctx, intr);
+   struct ir3_instruction *load;
+
+   if (!offset.src) {
+      load = ir3_LDTHR(b, addr, 0, offset.imm, 0,
+                     create_immed(b, dest_components), 0);
+   } else {
+      load = ir3_LDTHR_A(b, addr, 0, offset.src, 0, offset.src_shift, 0,
+                       offset.imm, 0, create_immed(b, dest_components), 0);
+   }
+
+   load->cat6.type = type_uint_size(dest_bit_size);
+   load->dsts[0]->wrmask = MASK(dest_components);
+
+   load->barrier_class = IR3_BARRIER_BUFFER_W;
+   load->barrier_conflict = IR3_BARRIER_BUFFER_R | IR3_BARRIER_BUFFER_W;
+
+   array_insert(ctx->block, ctx->block->keeps, load);
+}
+
 static void
 emit_intrinsic_store_global_ir3(struct ir3_context *ctx,
                                 nir_intrinsic_instr *intr)
@@ -726,4 +768,6 @@ const struct ir3_context_funcs ir3_a6xx_funcs = {
    .emit_intrinsic_load_global_ir3 = emit_intrinsic_load_global_ir3,
    .emit_intrinsic_store_global_ir3 = emit_intrinsic_store_global_ir3,
    .emit_intrinsic_atomic_global = emit_intrinsic_atomic_global,
+   .emit_intrinsic_invalidate_address_ir3 =
+      emit_intrinsic_invalidate_address_ir3,
 };
diff --git a/src/freedreno/ir3/ir3_compiler_nir.c b/src/freedreno/ir3/ir3_compiler_nir.c
index b2349fa7..80f9dad5 100644
--- a/src/freedreno/ir3/ir3_compiler_nir.c
+++ b/src/freedreno/ir3/ir3_compiler_nir.c
@@ -2915,6 +2915,9 @@ emit_intrinsic(struct ir3_context *ctx, nir_intrinsic_instr *intr)
    case nir_intrinsic_load_global_ir3:
       ctx->funcs->emit_intrinsic_load_global_ir3(ctx, intr, dst);
       break;
+   case nir_intrinsic_invalidate_address_ir3:
+      ctx->funcs->emit_intrinsic_invalidate_address_ir3(ctx, intr);
+      break;
 
    case nir_intrinsic_load_ubo:
       emit_intrinsic_load_ubo(ctx, intr, dst);
diff --git a/src/freedreno/ir3/ir3_context.h b/src/freedreno/ir3/ir3_context.h
index 82a63e87..fd8ca8ee 100644
--- a/src/freedreno/ir3/ir3_context.h
+++ b/src/freedreno/ir3/ir3_context.h
@@ -169,6 +169,8 @@ struct ir3_context_funcs {
                                            nir_intrinsic_instr *intr);
    struct ir3_instruction *(*emit_intrinsic_atomic_global)(
       struct ir3_context *ctx, nir_intrinsic_instr *intr);
+   void (*emit_intrinsic_invalidate_address_ir3)(struct ir3_context *ctx,
+                                                 nir_intrinsic_instr *intr);
 };
 
 extern const struct ir3_context_funcs ir3_a4xx_funcs;
